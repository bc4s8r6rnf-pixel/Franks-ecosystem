; Institutional Blxck Mirror - GBPUSD HIGH-FREQUENCY preset
; Loosened from presets/GBPUSD.set to trade closer to daily instead of a handful/yr.
; Every loosened gate trades some quality for frequency - validate PF/drawdown
; before going live. IMPORTANT: verify InpServerToNYOffset for YOUR broker first.
InpMagic=20260728
; --- Timeframes (enum ids: M1=1, M15=15, H4=16388, D1=16408) ---
InpBiasTF=16388
InpHTFTrend=16408
InpSetupTF=15
InpMicroTF=1
; --- Bias engine (loosened: majority vote instead of strict 3-way AND) ---
InpEmaFast=50
InpEmaSlow=200
InpStructLookback=40
InpSwingStrength=1
InpBiasMode=1
; --- Sessions (NEW YORK time) - Asia enabled, London/NY widened by 1h ---
InpServerToNYOffset=-7
InpAsiaStart=19
InpAsiaEnd=0
InpLondonStart=0
InpLondonEnd=6
InpNYStart=7
InpNYEnd=12
InpTradeLondon=true
InpTradeNewYork=true
InpTradeAsia=true
; --- Liquidity & setup (loosened: shorter/shallower sweep required) ---
InpSetupLookback=120
InpSweepMaxBars=14
InpSweepMinPips=0.5
InpLiqSwingStrength=2
InpMaxLiqPools=12
; --- FVG / IFVG ---
InpMinFvgPips=0.6
InpMicroFvgScan=40
; --- Risk & management (risk trimmed since frequency is much higher) ---
InpRiskPercent=0.5
InpFixedLots=0.0
InpSlBufferPips=2.5
InpMinRR=1.4
InpTP1_RR=2.0
InpFirstPartialPct=50.0
InpPartialPercent=70.0
InpMoveSlBehindFvg=true
InpTrailMicroFvg=true
InpMaxSpreadPips=5
InpMaxTradesPerDay=6
InpMaxStopPips=0.0
; --- ATR stop fallback ---
InpUseAtrStop=true
InpAtrPeriod=14
InpAtrMultSL=1.3
; --- News filter ---
InpUseNewsFilter=true
InpNewsImportance=2
InpNewsMinsBefore=15
InpNewsMinsAfter=15
; --- Win-rate boosters (displacement loosened, OTE kept) ---
InpUseDisplacement=true
InpMinBodyPct=45.0
InpDisplaceAtrMult=0.4
InpUseOTE=true
InpUseBreakEven=true
InpBreakEvenAtR=1.0
InpBreakEvenBufferPips=1.5
InpCloseAtSessionEnd=true
InpDailyMaxLossPct=3.0
InpDailyTargetPct=0.0
InpCooldownMin=15
; --- OTE entry model (dynamic) - tap IS the entry, displacement leg loosened ---
InpUseOTEModel=true
InpOTELow=0.62
InpOTEHigh=0.79
InpConfirmMode=0
InpMinDisplaceLeg=0.5
InpChocSwingStrength=2
InpChocLookback=100
InpChocMinRangeATR=1.0
InpFirstTP_SD=0.27
InpFinalSDs=2.0,2.5,3.0
InpTP1_SD=2.0
InpRunnerSD=3.0
; --- Execution & stop precision ---
InpEntryExec=0
InpOTEEntryFib=0.705
InpStopMode=1
InpPendingExpiryBars=4
InpMicroSwingLB=25
InpMicroSwingStr=2
InpMicroEntry=false
InpMicroPad=1.0
; --- Standard-deviation projections ---
InpUseSDProjection=true
InpSDMultiples=0.5,1.0,1.5,2.0,2.5,3.0
InpSDAlignPips=12.0
InpTargetMode=2
InpShowSDLevels=true
