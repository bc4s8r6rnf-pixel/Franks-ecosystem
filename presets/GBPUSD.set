; Institutional Blxck Mirror - GBPUSD preset (wider ranges than EURUSD)
; GBPUSD moves further and faster: wider pip filters, wider stop, higher RR.
; IMPORTANT: verify InpServerToNYOffset against YOUR broker's server clock first.
InpMagic=20260728
; --- Timeframes (enum ids: M1=1, M15=15, H4=16388, D1=16408) ---
InpBiasTF=16388
InpHTFTrend=16408
InpSetupTF=15
InpMicroTF=1
; --- Bias engine ---
InpEmaFast=50
InpEmaSlow=200
InpStructLookback=60
InpSwingStrength=2
InpBiasMode=0
; --- Sessions (NEW YORK time) ---
InpServerToNYOffset=-7
InpAsiaStart=19
InpAsiaEnd=0
InpLondonStart=1
InpLondonEnd=5
InpNYStart=7
InpNYEnd=11
InpTradeLondon=true
InpTradeNewYork=true
InpTradeAsia=false
; --- High-probability entry windows (NY time, decimal hours) ---
InpUsePrimeWindow=true
InpLondonPrimeStart=2.0
InpLondonPrimeEnd=4.0
InpNYPrimeStart=8.0
InpNYPrimeEnd=9.5
; --- Liquidity & setup ---
InpSetupLookback=120
InpSweepMaxBars=8
InpSweepMinPips=1.0
InpLiqSwingStrength=2
InpMaxLiqPools=12
; --- FVG / IFVG ---
InpMinFvgPips=1.0
InpMicroFvgScan=40
; --- Risk & management ---
InpRiskPercent=0.75
InpFixedLots=0.0
InpSlBufferPips=2.5
InpMinRR=2.5
InpTP1_RR=2.0
InpFirstPartialPct=50.0
InpPartialPercent=70.0
InpMoveSlBehindFvg=true
InpTrailMicroFvg=true
InpMaxSpreadPips=4
InpMaxTradesPerDay=2
InpMaxStopPips=0.0
; --- ATR stop fallback ---
InpUseAtrStop=true
InpAtrPeriod=14
InpAtrMultSL=1.3
; --- News filter ---
InpUseNewsFilter=true
InpNewsImportance=2
InpNewsMinsBefore=15
InpNewsMinsAfter=15
; --- Win-rate boosters ---
InpUseDisplacement=true
InpMinBodyPct=55.0
InpDisplaceAtrMult=0.6
InpUseOTE=true
InpUseBreakEven=true
InpBreakEvenAtR=1.0
InpBreakEvenBufferPips=1.5
InpCloseAtSessionEnd=true
InpDailyMaxLossPct=3.0
InpDailyTargetPct=0.0
InpCooldownMin=30
; --- OTE entry model (dynamic) ---
InpUseOTEModel=true
InpOTELow=0.62
InpOTEHigh=0.79
InpConfirmMode=0
InpMinDisplaceLeg=1.0
InpChocSwingStrength=3
InpChocLookback=300
InpChocMinRangeATR=1.5
InpMinStopPips=8.0
InpAnchorCooldownMin=240
InpAnchorCooldownPips=15.0
InpFirstTP_SD=0.27
InpFinalSDs=2.0,2.5,3.0
InpTP1_SD=2.0
InpRunnerSD=3.0
; --- Execution & stop precision (balanced tight) ---
InpEntryExec=0
InpOTEEntryFib=0.705
InpStopMode=1
InpPendingExpiryBars=4
InpMicroSwingLB=25
InpMicroSwingStr=2
InpMicroEntry=false
InpMicroPad=1.0
; --- Standard-deviation projections ---
InpUseSDProjection=true
InpSDMultiples=0.5,1.0,1.5,2.0,2.5,3.0
InpSDAlignPips=12.0
InpTargetMode=2
InpShowSDLevels=true
