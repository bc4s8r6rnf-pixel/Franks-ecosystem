     group = "Exit marker")
xTally  = input.bool(true, "Running R tally in the panel", group = "Exit marker")

shEntry = input.bool(true, "Entry", inline = "e", group = "Levels")
cEntry  = input.color(color.new(#b0bec5, 0), "", inline = "e", group = "Levels")
sEntry  = input.string("Dotted", "", options = ["Solid", "Dashed", "Dotted"], inline = "e", group = "Levels")
