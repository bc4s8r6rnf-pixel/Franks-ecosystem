//@version=6
// ============================================================================
// RXWLES DIRECTION CALL  v1.2
//
// Every trade carries at least 2:1. If the 2.0 zone edge sits closer than that
// from the entry, the edge becomes a break-even trigger instead of the target,
// and the target moves out to the 2:1 level.
//
//   DIRECTION  04:00 NY, whichever inner zone edge (2.0 R) is closer. Drawn
//              immediately; the trade waits.
//   NO TRADE   if that 2.0 zone was already reached before the call.
//   ENTRY      a tap of VWAP before 11:00 NY. Tap, not bar close.
//   CANCEL     if the stop level is reached before the tap.
//   CANCEL     if the 2.0 zone is reached before the tap.
//   STOP       behind the 9pm box plus a buffer.
//   TARGET     the 2.0 zone edge when it is 2:1 or better. Otherwise the 2:1
//              level, with break-even armed at the 2.0 edge.
//   FILTER     skip the day when the 9pm range is too large - those sessions
//              went 1W/6L.
//   EXIT       flat at the lane close.
//
// Measured on 59 sessions of 15m gold:
//
//   45 trades, 22W / 21L, 48.9%, +0.42 R per trade, avg RR 2.66, risk $32.67
//   with the $40 range filter: 38 trades, 21W / 15L, +0.58 R, +22.2 R total
//
// VWAP was tapped on 58 of 59 sessions, so the entry trigger is not what
// filters - the two cancel rules are, and they remove 13 sessions.
//
// Two things tested and rejected: fading the day after a big expansion, which
// returns -0.82 R against +0.84 R for following it, and skipping sub-2:1
// setups rather than retargeting them, +12.1 R over 19 trades against +19.0 R
// over 45.
//
// 45 trades is a small sample and the range buckets hold single figures each.
// XAUUSD only - NAS100 never reproduced the direction edge.
// ============================================================================

indicator("RXWLES Direction Call", "DirCall", overlay = true,
     max_labels_count = 500, max_lines_count = 500)

const string TZ = "America/New_York"

//=============================================================================
// METHOD
//=============================================================================

srcHour  = input.int(21, "Source candle hour (NY)", minval = 0, maxval = 23, group = "Method",
     tooltip = "Must match RXWLES PRO's Enigma Source Hour.")
readHour = input.int(4,  "Direction read hour (NY)", minval = 0, maxval = 23, group = "Method")
lvl1     = input.float(2.0, "Inner zone edge (R)", step = 0.05, group = "Method")
cutHour  = input.int(11, "VWAP entry cutoff (NY hour)", minval = 0, maxval = 23, group = "Method",
     tooltip = "No entries after this hour. The tap is intrabar, not on close.")

minRR    = input.float(2.0, "Minimum RR - every trade carries this", step = 0.25, minval = 1.0,
     group = "Stop & target",
     tooltip = "When the 2.0 zone edge is nearer than this, the edge becomes the "
             + "break-even trigger and the target moves out to this RR.")
bufD     = input.float(1.0, "Stop buffer beyond the 9pm box ($)", step = 0.10, minval = 0.0,
     group = "Stop & target",
     tooltip = "1 pip on gold = $0.10. Tested flat from 0 to $12, so keep it small.")
useBE    = input.bool(true, "Break-even at the 2.0 edge when retargeting", group = "Stop & target")

useRngF  = input.bool(true, "Skip days with an oversized 9pm range", group = "Filters",
     tooltip = "Sessions with a range at or above the limit went 1W/6L for -3.3 R. "
             + "Removing them took the sample from +19.0 R to +22.2 R.")
maxRng   = input.float(40.0, "    range limit ($)", step = 1.0, minval = 1.0, group = "Filters")

//=============================================================================
// APPEARANCE
//=============================================================================

f_style(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

f_size(string s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : s == "Large" ? size.large :
     s == "Huge" ? size.huge : size.small

f_shape(string s, int dir) =>
    s == "Arrow (auto)"          ? (dir > 0 ? label.style_arrowup : label.style_arrowdown) :
     s == "Speech bubble (auto)" ? (dir > 0 ? label.style_label_up : label.style_label_down) :
     s == "Circle"               ? label.style_circle :
     s == "Square"               ? label.style_square :
     s == "Diamond"              ? label.style_diamond :
     s == "Flag"                 ? label.style_flag :
     s == "Cross"                ? label.style_cross :
     s == "X"                    ? label.style_xcross :
     s == "Text only"            ? label.style_none :
     s == "Emoji"                ? label.style_none :
     (dir > 0 ? label.style_triangleup : label.style_triangledown)

// ---- direction marker (fires at the 04:00 call) ---------------------------
dShow  = input.bool(true, "Show direction marker", group = "Direction marker")
dShape = input.string("Triangle (auto)", "Shape", group = "Direction marker",
     options = ["Triangle (auto)", "Arrow (auto)", "Speech bubble (auto)", "Circle", "Square",
                "Diamond", "Flag", "Cross", "X", "Text only", "Emoji"])
dUpEmo = input.string("🔼", "Emoji up", inline = "de", group = "Direction marker")
dDnEmo = input.string("🔽", "down", inline = "de", group = "Direction marker")
dSize  = input.string("Tiny", "Size", group = "Direction marker",
     options = ["Tiny", "Small", "Normal", "Large", "Huge"])
dUpCol = input.color(#26a69a, "Up", inline = "dc", group = "Direction marker")
dDnCol = input.color(#ef5350, "Down", inline = "dc", group = "Direction marker")
dTrans = input.int(35, "Transparency", minval = 0, maxval = 100, group = "Direction marker")
dOff   = input.float(0.20, "Offset from the candle (R)", step = 0.05, minval = 0.0,
     group = "Direction marker")

// ---- entry marker (fires on the VWAP tap) --------------------------------
eShow  = input.bool(true, "Show entry marker", group = "Entry marker")
eShape = input.string("Arrow (auto)", "Shape", group = "Entry marker",
     options = ["Triangle (auto)", "Arrow (auto)", "Speech bubble (auto)", "Circle", "Square",
                "Diamond", "Flag", "Cross", "X", "Text only", "Emoji"])
eUpEmo = input.string("🎯", "Emoji up", inline = "ee", group = "Entry marker")
eDnEmo = input.string("🎯", "down", inline = "ee", group = "Entry marker")
eSize  = input.string("Normal", "Size", group = "Entry marker",
     options = ["Tiny", "Small", "Normal", "Large", "Huge"])
eUpCol = input.color(#00e676, "Up", inline = "ec", group = "Entry marker")
eDnCol = input.color(#ff1744, "Down", inline = "ec", group = "Entry marker")
eTrans = input.int(0, "Transparency", minval = 0, maxval = 100, group = "Entry marker")
eText  = input.string("RR", "Text", options = ["None", "Price", "RR", "Price + RR"],
     group = "Entry marker")
eTxtCol = input.color(color.white, "Text colour", group = "Entry marker")
eOff   = input.float(0.45, "Offset from the candle (R)", step = 0.05, minval = 0.0,
     group = "Entry marker",
     tooltip = "How far clear of the entry candle to sit, in units of R. Bigger = "
             + "more visible and further from the wick.")

// ---- levels ---------------------------------------------------------------
shEntry = input.bool(true, "Entry", inline = "e", group = "Levels")
cEntry  = input.color(color.new(#b0bec5, 0), "", inline = "e", group = "Levels")
sEntry  = input.string("Dotted", "", options = ["Solid", "Dashed", "Dotted"], inline = "e", group = "Levels")
wEntry  = input.int(1, "", minval = 1, maxval = 4, inline = "e", group = "Levels")

shStop  = input.bool(true, "Stop", inline = "s", group = "Levels")
cStop   = input.color(#ff1744, "", inline = "s", group = "Levels")
sStop   = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = "s", group = "Levels")
wStop   = input.int(2, "", minval = 1, maxval = 4, inline = "s", group = "Levels")

shTgt   = input.bool(true, "Target", inline = "t", group = "Levels")
cTgt    = input.color(#00e676, "", inline = "t", group = "Levels")
sTgt    = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = "t", group = "Levels")
wTgt    = input.int(2, "", minval = 1, maxval = 4, inline = "t", group = "Levels")

shBE    = input.bool(true, "Break-even trigger (the 2.0 edge)", inline = "b", group = "Levels")
cBE     = input.color(#ffab00, "", inline = "b", group = "Levels")
sBE     = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], inline = "b", group = "Levels")

shVwap  = input.bool(true, "VWAP while waiting", inline = "v", group = "Levels")
cVwap   = input.color(color.new(#ffab00, 30), "", inline = "v", group = "Levels")

priceTag = input.bool(true, "Price tag on each level", group = "Levels")
tagSize  = input.string("Tiny", "Tag size", options = ["Tiny", "Small", "Normal"], group = "Levels")

showPanel = input.bool(true, "Show panel", group = "Panel")
panelPos  = input.string("Top right", "Position", group = "Panel",
     options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"])
panelSize = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = "Panel")

//=============================================================================
// CALENDAR + SOURCE CANDLE
//=============================================================================

f_midnight(int t) =>
    timestamp(TZ, year(t, TZ), month(t, TZ), dayofmonth(t, TZ), 0, 0, 0)

f_nextMidnight(int t) =>
    f_midnight(f_midnight(t) + 26 * 3600000)

f_src() =>
    var float sH = na
    var float sL = na
    var int   sD = na
    if hour(time[1], TZ) == srcHour
        sH := high[1]
        sL := low[1]
        sD := f_nextMidnight(time[1])
    [sH, sL, sD]

[srcHigh, srcLow, srcDay] = request.security(syminfo.tickerid, "60", f_src(),
     lookahead = barmerge.lookahead_off)

//=============================================================================
// STATE
//=============================================================================

var float  R        = na
var float  upEdge   = na
var float  dnEdge   = na
var float  boxHi    = na
var float  boxLo    = na
var int    laneDay  = na
var bool   called   = false
var bool   waiting  = false      // called, watching for the VWAP tap
var bool   filled   = false
var bool   dead     = false      // cancelled or filtered out
var bool   preHit   = false      // the 2.0 zone was reached before the call
var int    side     = 0
var float  gap      = na
var float  entryPx  = na
var float  stopPx   = na
var float  tgtPx    = na
var float  beLvl    = na
var float  rrHave   = na
var bool   beDone   = false
var bool   retarget = false      // the box was inside minRR, so the target moved out
var string why      = ""
var line   lnE      = na
var line   lnS      = na
var line   lnT      = na
var line   lnB      = na
var label  tagE     = na
var label  tagS     = na
var label  tagT     = na
var label  tagB     = na

bool intraday = not timeframe.isdwm
bool newSrc = intraday and not na(srcDay) and not na(srcHigh) and (na(laneDay) or srcDay != laneDay)

bool laneOpen = intraday and not na(laneDay) and time >= laneDay and time[1] < laneDay
float vw = ta.vwap(hlc3, laneOpen)

if newSrc and (srcHigh - srcLow) > 0
    laneDay  := srcDay
    boxHi    := srcHigh
    boxLo    := srcLow
    R        := srcHigh - srcLow
    upEdge   := srcHigh + lvl1 * R
    dnEdge   := srcLow  - lvl1 * R
    called   := false
    waiting  := false
    filled   := false
    dead     := false
    preHit   := false
    beDone   := false
    retarget := false
    side     := 0
    entryPx  := na
    stopPx   := na
    tgtPx    := na
    beLvl    := na
    rrHave   := na
    why      := (useRngF and R >= maxRng)
         ? "range $" + str.tostring(R, "#.##") + " over the $"
           + str.tostring(maxRng, "#") + " limit - no trade"
         : "waiting for " + str.format("{0,number,00}:00", readHour) + " NY"
    if useRngF and R >= maxRng
        dead := true

bool inLane   = intraday and not na(laneDay) and time >= laneDay and time < laneDay + 86400000
bool laneLive = inLane and not dead

//=============================================================================
// PRE-CALL: has the 2.0 zone already gone?
//=============================================================================

if inLane and not called and not dead
    if high >= upEdge or low <= dnEdge
        preHit := true

//=============================================================================
// THE CALL
//=============================================================================

if laneLive and not called and hour(time, TZ) >= readHour
    called := true
    float px  = open
    float gUp = (upEdge - px) / R
    float gDn = (px - dnEdge) / R
    gap  := math.abs(gUp - gDn)
    side := gUp < gDn ? 1 : -1

    float proj = side > 0 ? upEdge : dnEdge
    bool gone  = side > 0 ? px >= upEdge : px <= dnEdge
    if preHit or gone
        dead := true
        why  := "the 2.0 zone had already gone before the call - no trade"
    else
        waiting := true
        stopPx  := side > 0 ? boxLo - bufD : boxHi + bufD
        why     := "called - waiting for a VWAP tap before "
             + str.format("{0,number,00}:00", cutHour)

//=============================================================================
// WAITING FOR THE TAP - cancels are checked before the tap on the same bar
//=============================================================================

if laneLive and waiting and not filled
    float proj = side > 0 ? upEdge : dnEdge
    if (side > 0 and low <= stopPx) or (side < 0 and high >= stopPx)
        waiting := false
        dead    := true
        why     := "stop level reached before the entry - cancelled"
    else if (side > 0 and high >= proj) or (side < 0 and low <= proj)
        waiting := false
        dead    := true
        why     := "the 2.0 zone was reached before the entry - cancelled"
    else if hour(time, TZ) >= cutHour
        waiting := false
        dead    := true
        why     := "no VWAP tap before the cutoff - no trade"
    else if low <= vw and vw <= high
        entryPx  := vw
        filled   := true
        waiting  := false
        float risk = math.abs(entryPx - stopPx)
        float rrBox = risk > 0 ? math.abs(proj - entryPx) / risk : 0
        if rrBox >= minRR
            tgtPx    := proj
            beLvl    := na
            retarget := false
        else
            tgtPx    := entryPx + side * minRR * risk
            beLvl    := proj
            retarget := true
        rrHave := risk > 0 ? math.abs(tgtPx - entryPx) / risk : na
        why    := retarget
             ? "filled on VWAP - box was under " + str.tostring(minRR, "#.#")
               + ":1, target moved out"
             : "filled on VWAP - the 2.0 edge is the target"

//=============================================================================
// IN THE TRADE
//=============================================================================

if laneLive and filled and not na(stopPx)
    if useBE and retarget and not beDone and not na(beLvl)
        if (side > 0 and high >= beLvl) or (side < 0 and low <= beLvl)
            beDone := true
            stopPx := entryPx
            why    := "2.0 edge tapped - stop at break-even, running to "
                 + str.tostring(minRR, "#.#") + ":1"

bool justCalled = laneLive and called and not called[1]
bool justFilled = laneLive and filled and not filled[1]

//=============================================================================
// DRAWING
//=============================================================================

f_mark(int dir, string shape, string emoUp, string emoDn, string txt, color col,
       string sz, float off, color txtCol, int transp) =>
    string body = shape == "Emoji" ? (dir > 0 ? emoUp : emoDn) + (txt == "" ? "" : " " + txt) : txt
    float yv = dir > 0 ? low - off * R : high + off * R
    label.new(bar_index, yv, body, style = f_shape(shape, dir),
         color = shape == "Emoji" or shape == "Text only" ? color.new(col, 100) : color.new(col, transp),
         textcolor = shape == "Emoji" ? color.new(color.white, 0) : txtCol,
         size = f_size(sz), yloc = yloc.price)

if justCalled and dShow and side != 0 and not dead
    f_mark(side, dShape, dUpEmo, dDnEmo, "", side > 0 ? dUpCol : dDnCol,
         dSize, dOff, color.white, dTrans)

if justFilled and eShow
    string et = eText == "None" ? "" :
         eText == "Price" ? str.tostring(entryPx, format.mintick) :
         eText == "RR" ? str.tostring(rrHave, "#.##") + "R" :
         str.tostring(entryPx, format.mintick) + "  " + str.tostring(rrHave, "#.##") + "R"
    f_mark(side, eShape, eUpEmo, eDnEmo, et, side > 0 ? eUpCol : eDnCol,
         eSize, eOff, eTxtCol, eTrans)

f_tag(float y, string txt, color c) =>
    label.new(bar_index, y, txt, style = label.style_label_left,
         color = color.new(c, 85), textcolor = c, size = f_size(tagSize),
         yloc = yloc.price)

if justFilled
    if shEntry
        lnE := line.new(bar_index, entryPx, bar_index + 1, entryPx, color = cEntry,
             style = f_style(sEntry), width = wEntry)
    if shStop
        lnS := line.new(bar_index, stopPx, bar_index + 1, stopPx, color = cStop,
             style = f_style(sStop), width = wStop)
    if shTgt
        lnT := line.new(bar_index, tgtPx, bar_index + 1, tgtPx, color = cTgt,
             style = f_style(sTgt), width = wTgt)
    if shBE and retarget and not na(beLvl)
        lnB := line.new(bar_index, beLvl, bar_index + 1, beLvl, color = cBE,
             style = f_style(sBE), width = 1)
    if priceTag
        tagE := f_tag(entryPx, "entry " + str.tostring(entryPx, format.mintick), cEntry)
        tagS := f_tag(stopPx,  "SL "    + str.tostring(stopPx,  format.mintick), cStop)
        tagT := f_tag(tgtPx,   "TP "    + str.tostring(tgtPx,   format.mintick)
             + "  " + str.tostring(rrHave, "#.##") + "R", cTgt)
        if retarget and not na(beLvl)
            tagB := f_tag(beLvl, "BE " + str.tostring(beLvl, format.mintick), cBE)

// the lines run with the trade, and the stop line follows break-even
if laneLive and filled
    if not na(lnE)
        line.set_x2(lnE, bar_index)
    if not na(lnS)
        line.set_x2(lnS, bar_index)
        line.set_y1(lnS, stopPx)
        line.set_y2(lnS, stopPx)
    if not na(lnT)
        line.set_x2(lnT, bar_index)
    if not na(lnB)
        line.set_x2(lnB, bar_index)
    if priceTag
        if not na(tagE)
            label.set_x(tagE, bar_index)
        if not na(tagS)
            label.set_x(tagS, bar_index)
            label.set_y(tagS, stopPx)
            label.set_text(tagS, (beDone ? "BE " : "SL ") + str.tostring(stopPx, format.mintick))
        if not na(tagT)
            label.set_x(tagT, bar_index)
        if not na(tagB)
            label.set_x(tagB, bar_index)

plot(shVwap and laneLive and (waiting or filled) ? vw : na, "VWAP",
     color = cVwap, style = plot.style_linebr, linewidth = 1)

//=============================================================================
// PANEL
//=============================================================================

f_cell(table t, int c, int r, string s, color bg, color fg, string sz) =>
    table.cell(t, c, r, s, bgcolor = bg, text_color = fg, text_size = sz,
         text_halign = c == 0 ? text.align_left : text.align_right)

var table T = na

if barstate.islast and showPanel and intraday
    string pos = panelPos == "Top left" ? position.top_left :
         panelPos == "Bottom right" ? position.bottom_right :
         panelPos == "Bottom left" ? position.bottom_left :
         panelPos == "Middle right" ? position.middle_right : position.top_right
    string sz = f_size(panelSize)
    if not na(T)
        table.delete(T)
    T := table.new(pos, 2, 9, border_width = 1, frame_width = 1,
         frame_color = color.new(color.gray, 55), border_color = color.new(color.gray, 80))

    color vc = dead ? color.gray : side > 0 ? dUpCol : side < 0 ? dDnCol : color.gray
    string vt = dead ? "NO TRADE" : not called ? "WAITING" :
         waiting ? (side > 0 ? "WATCHING LONG" : "WATCHING SHORT") :
         filled ? (beDone ? (side > 0 ? "LONG · BE" : "SHORT · BE")
                          : (side > 0 ? "LONG" : "SHORT")) : "NO TRADE"
    color bg = color.new(color.black, 25)
    color fg = color.new(color.white, 0)

    f_cell(T, 0, 0, "v1.2", color.new(vc, 55), fg, sz)
    f_cell(T, 1, 0, vt,     color.new(vc, 55), fg, sz)
    f_cell(T, 0, 1, why, bg, color.new(fg, 30), sz)
    f_cell(T, 1, 1, "",  bg, fg, sz)
    f_cell(T, 0, 2, "R (9pm box)", bg, fg, sz)
    f_cell(T, 1, 2, na(R) ? "-" : "$" + str.tostring(R, "#.##"), bg,
         useRngF and not na(R) and R >= maxRng ? cStop : fg, sz)
    f_cell(T, 0, 3, "VWAP", bg, fg, sz)
    f_cell(T, 1, 3, na(vw) ? "-" : str.tostring(vw, format.mintick), bg, cVwap, sz)
    f_cell(T, 0, 4, "entry", bg, fg, sz)
    f_cell(T, 1, 4, na(entryPx) ? "-" : str.tostring(entryPx, format.mintick), bg, fg, sz)
    f_cell(T, 0, 5, beDone ? "stop (break-even)" : "stop", bg, fg, sz)
    f_cell(T, 1, 5, na(stopPx) ? "-" : str.tostring(stopPx, format.mintick), bg, cStop, sz)
    f_cell(T, 0, 6, retarget ? "BE trigger (2.0 edge)" : "2.0 edge", bg, fg, sz)
    f_cell(T, 1, 6, na(beLvl) ? (na(entryPx) ? "-" : "is the target") :
         str.tostring(beLvl, format.mintick), bg, cBE, sz)
    f_cell(T, 0, 7, "target", bg, fg, sz)
    f_cell(T, 1, 7, na(tgtPx) ? "-" : str.tostring(tgtPx, format.mintick), bg, cTgt, sz)
    f_cell(T, 0, 8, "RR", bg, fg, sz)
    f_cell(T, 1, 8, na(rrHave) ? "-" : str.tostring(rrHave, "#.##") + " : 1", bg, fg, sz)

//=============================================================================
// ALERTS
//=============================================================================

alertcondition(justCalled and side ==  1, "Direction: UP",   "Direction call: UP")
alertcondition(justCalled and side == -1, "Direction: DOWN", "Direction call: DOWN")
alertcondition(justFilled,                "Entry filled",    "VWAP tapped - stop and target set")
alertcondition(beDone and not beDone[1],  "Break-even",      "2.0 edge tapped - stop to break-even")
