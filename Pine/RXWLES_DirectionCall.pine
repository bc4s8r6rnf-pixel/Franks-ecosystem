//@version=6
// ============================================================================
// XAU //PRO 79 JECT  v5.1
//
// THE RULES, in the order they happen.
//
//  1  The 21:00 NY candle sets the range R. Two projection zones are drawn as
//     boxes for the day: 2.0 to 2.5 above, 2.0 to 2.5 below. That is the map.
//
//  2  At the read hour the direction call names a side. In Direction mode only
//     that side can trade. In Optimal mode both sides are live and the day
//     keeps whichever one reaches target.
//
//  3  Fibs, drawn as levels only - no boxes:
//        zone to zone      1 on one 2.0 edge, -0.27 on the opposing 2.0 edge.
//                          Both directions, always.
//        previous swing    1 on yesterday's last swing. A pivot high anchors a
//                          short, a pivot low anchors a long, so each swing fib
//                          exists in ONE direction only. With Swing anchor set
//                          to "Both sides" yesterday's last pivot high and last
//                          pivot low are both carried and the mode decides which
//                          of the two is allowed to trade.
//     The -0.27 is always the opposing 2.0 edge, so the target is the same
//     price for every fib on a side.
//
//  4  Entry, between 08:00 and 09:30 NY and at no other time:
//        price must trade into the 0.62 - 0.79 band, and then a ONE MINUTE
//        candle must CLOSE back outside it on the target side. That close is
//        the entry. Nothing before 08:00 counts, nothing after 09:30 counts.
//
//  5  Stop is the 0.95 level. Target is the -0.27, i.e. the opposing 2.0 edge.
//
//  6  If a fib is entered and stopped, that fib is finished. Price may then
//     reach a deeper fib on the same side; if that one is respected the same
//     way, it is entered on the same rules. Every fib on the called side gets
//     its turn.
//
//  7  The target line runs on until the target is met, then freezes there.
//     A stop ends it instead. An open trade is never cancelled by the next
//     midnight - only untouched fibs are deleted at the open.
//
// Measured over 3,482-3,673 trades, 2004-2026, anchored to yesterday's swing:
// entry 0.62 PF 1.15, 0.70 PF 1.14, 0.79 PF 1.14; stop 0.88 PF 1.16, 0.95 PF
// 1.14, 1.00 PF 1.05. The direction call is 72.5% on 2,597 undecided sessions.
// ============================================================================

indicator("XAU //PRO 79 JECT", "XAU79", overlay = true,
     max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

const string TZ = "America/New_York"

//=============================================================================
// INPUTS
//=============================================================================

srcHour  = input.int(21, "Source candle hour (NY)", minval = 0, maxval = 23,
     group = "Method", tooltip = "Must match RXWLES PRO's Enigma Source Hour.")
readHour = input.int(4,  "Direction read hour (NY)", minval = 0, maxval = 23,
     group = "Method")
winFrom  = input.session("0800-0930", "Entry window (NY)", group = "Method",
     tooltip = "Price may only enter a fib inside this window. The one-minute " +
               "close that confirms the entry must also fall inside it.")
endHour  = input.int(17, "Day ends (NY hour)", minval = 1, maxval = 24,
     group = "Method")

trMode   = input.string("Direction", "Mode", options = ["Direction", "Optimal"],
     group = "Trade",
     tooltip = "Identical rules. Direction trades only the called side. Optimal " +
               "runs both sides and keeps whichever reaches target - which is a " +
               "review tool, since it settles the side after the fact.")
trEntry  = input.string("0.79", "Entry fib", options = ["0.62", "0.70", "0.79"],
     group = "Trade")
trStop   = input.string("0.95", "Stop fib", options = ["0.88", "0.95", "1.00"],
     group = "Trade")

useEma   = input.bool(false, "90 EMA filter", inline = "em", group = "Trade",
     tooltip = "On: a long only fires with price above the EMA, a short only " +
               "below it, tested at the moment of entry.")
emaLen   = input.int(90, "", minval = 2, inline = "em", group = "Trade")
emaCol   = input.color(color.new(#c8d4de, 45), "", inline = "em", group = "Trade")
emaShow  = input.bool(true, "plot it", inline = "em", group = "Trade")

fzZ2Z    = input.bool(true, "Zone to zone fib",    inline = "fa", group = "Fibs")
fzSw     = input.bool(true, "Previous swing fib",  inline = "fa", group = "Fibs")
fzPiv    = input.int(5, "Swing strength", minval = 1, maxval = 30, group = "Fibs")
fzSwPick = input.string("Both sides", "Swing anchor",
     options = ["Both sides", "Last pivot only"], group = "Fibs",
     tooltip = "Both sides: yesterday's last pivot high anchors a short and its " +
               "last pivot low anchors a long, and the mode decides which trades. " +
               "Last pivot only: just whichever of the two confirmed last, which " +
               "is the literal reading of the rule but lets a late wiggle erase " +
               "the swing you actually drew.")
fzNums   = input.bool(true, "Retracement numbers", inline = "fn", group = "Fibs")
fzTxt    = input.string("Tiny", "", options = ["Tiny", "Small", "Normal"],
     inline = "fn", group = "Fibs")
fzLnZ    = input.color(color.new(#8fa6b8, 40), "Zone-to-zone",  inline = "fc", group = "Fibs")
fzLnS    = input.color(color.new(#b8a68f, 40), "Prev swing",    inline = "fc", group = "Fibs")
fzOte    = input.color(color.new(#c8d4de, 78), "OTE band tint", group = "Fibs")
fzStpC   = input.color(color.new(#c96a6a, 25), "Stop",   inline = "fs", group = "Fibs")
fzTgtC   = input.color(color.new(#4db6a0, 25), "Target", inline = "fs", group = "Fibs")
fzW      = input.int(1, "width", minval = 1, maxval = 3, inline = "fs", group = "Fibs")

pzShow   = input.bool(true, "Projection zones", inline = "pz", group = "Zones")
pzUp     = input.color(color.new(#4db6a0, 88), "up",   inline = "pz", group = "Zones")
pzDn     = input.color(color.new(#c96a6a, 88), "down", inline = "pz", group = "Zones")
pzBord   = input.color(color.new(#a8b8c4, 55), "border", inline = "pz", group = "Zones")
dvShow   = input.bool(true, "Midnight divider", inline = "dv", group = "Zones")
dvCol    = input.color(color.new(#8899a6, 60), "", inline = "dv", group = "Zones")

dShow    = input.bool(true, "Direction marker", inline = "d1", group = "Markers")
dUpCol   = input.color(color.new(#4db6a0, 25), "up",   inline = "d1", group = "Markers")
dDnCol   = input.color(color.new(#c96a6a, 25), "down", inline = "d1", group = "Markers")
dConf    = input.bool(true, "confidence %", inline = "d2", group = "Markers")
mkSize   = input.string("Tiny", "size", options = ["Tiny", "Small", "Normal"],
     inline = "d2", group = "Markers")

acBal    = input.float(100000.0, "Account balance ($)", minval = 1, group = "Risk")
acRisk   = input.float(1.0, "Risk per trade (%)", minval = 0.01, step = 0.05,
     group = "Risk")
acFrom   = input.time(timestamp("2026-01-01 00:00 -0500"), "Track from", group = "Risk")
acShow   = input.bool(true, "Print results", group = "Risk")
acWinC   = input.color(#4db6a0, "win",  inline = "ac", group = "Risk")
acLosC   = input.color(#c96a6a, "loss", inline = "ac", group = "Risk")

pnShow   = input.bool(true, "Show panel", group = "Panel")
pnPos    = input.string("Top right", "Position", group = "Panel",
     options = ["Top right", "Top left", "Bottom right", "Bottom left"])
pnSize   = input.string("Tiny", "Text", options = ["Tiny", "Small", "Normal"],
     group = "Panel")

//=============================================================================
// HELPERS
//=============================================================================

f_size(string s) => s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : size.small
f_lv(float a_, float t_, float f) => a_ + (1.0 - f) / 1.27 * (t_ - a_)
f_mid(int t) => timestamp(TZ, year(t, TZ), month(t, TZ), dayofmonth(t, TZ), 0, 0, 0)

float trEntF = str.tonumber(trEntry)
float trStpF = str.tonumber(trStop)

//=============================================================================
// SOURCE CANDLE, LANE, ANCHORS
//=============================================================================

bool intraday = not timeframe.isdwm

var float srcHigh = na
var float srcLow  = na
var int   srcDay  = na
if intraday and hour(time[1], TZ) == srcHour
    srcHigh := na(srcHigh) or hour(time[2], TZ) != srcHour ? high[1] : math.max(srcHigh, high[1])
    srcLow  := na(srcLow)  or hour(time[2], TZ) != srcHour ? low[1]  : math.min(srcLow,  low[1])
    srcDay  := f_mid(f_mid(time[1]) + 26 * 3600000)

var int   laneDay = na
var float boxHi   = na
var float boxLo   = na
var float R       = na
var float z20u    = na
var float z20d    = na
var float z25u    = na
var float z25d    = na
var int   side    = 0
var bool  called  = false
var float cfRaw   = na
var float cfHit   = na

var int   stW = 0
var int   stL = 0
var float stRw = 0.0
var float stRl = 0.0
var int   stCallW = 0
var int   stCallN = 0

bool newSrc = intraday and not na(srcDay) and not na(srcHigh)
     and (na(laneDay) or srcDay != laneDay)
if newSrc and (srcHigh - srcLow) > 0
    laneDay := srcDay
    boxHi   := srcHigh
    boxLo   := srcLow
    R       := srcHigh - srcLow
    z20u    := srcHigh + 2.0 * R
    z20d    := srcLow  - 2.0 * R
    z25u    := srcHigh + 2.5 * R
    z25d    := srcLow  - 2.5 * R
    called  := false
    side    := 0

bool laneOpen = intraday and not na(laneDay) and time >= laneDay and time[1] < laneDay
bool inLane   = intraday and not na(laneDay) and time >= laneDay
     and time < laneDay + 86400000
bool inDay    = inLane and hour(time, TZ) < endHour
bool inWin    = intraday and not na(time(timeframe.period, winFrom, TZ))

// Yesterday's last swing. The old code kept ONE number - whichever pivot type
// happened to confirm last - so a five-bar wiggle at 23:00 overwrote the real
// swing high at 18:30 and the short fib that swing anchors was never built at
// all. Both of yesterday's last pivots are now carried, and "Both sides" builds
// the fib each one supports: a pivot high anchors a short, a pivot low a long.
var float pvHi = na
var float pvLo = na
var bool  pvLowLast = false
var float dayPvH = na
var float dayPvL = na
var bool  dayPvLast = false
float _ph = ta.pivothigh(high, fzPiv, fzPiv)
float _pl = ta.pivotlow(low,  fzPiv, fzPiv)
if not na(_ph)
    pvHi := _ph
    pvLowLast := false
if not na(_pl)
    pvLo := _pl
    pvLowLast := true
if laneOpen
    dayPvH    := pvHi
    dayPvL    := pvLo
    dayPvLast := pvLowLast

float ema90 = ta.ema(close, emaLen)
plot(emaShow and useEma ? ema90 : na, "90 EMA", color = emaCol, linewidth = 1)

//=============================================================================
// THE CALL
//=============================================================================

f_cfHit(float raw) =>
    raw < 0.05 ? 57.7 : raw < 0.10 ? 64.0 : raw < 0.15 ? 68.2 :
     raw < 0.20 ? 74.8 : raw < 0.25 ? 78.4 : raw < 0.35 ? 81.3 : 94.9

if inLane and not called and not na(R) and R > 0 and hour(time, TZ) >= readHour
    called := true
    float pz = (open - z20d) / (z20u - z20d)
    cfRaw := math.abs(pz - 0.5)
    cfHit := f_cfHit(cfRaw)
    side  := pz > 0.5 ? 1 : -1

bool justCalled = inLane and called and not called[1]

var int  clSide = 0
var bool clOpen = false
if justCalled and side != 0 and time >= acFrom
    clSide := side
    clOpen := true
if clOpen and not na(z20u)
    bool hu = high >= z20u
    bool hd = low  <= z20d
    if hu or hd
        stCallN += 1
        stCallW += ((hu and clSide > 0) or (hd and clSide < 0)) ? 1 : 0
        clOpen  := false

if dShow and justCalled and side != 0 and not na(R)
    label.new(bar_index, side > 0 ? low - 0.25 * R : high + 0.25 * R,
         dConf and not na(cfHit) ? str.tostring(cfHit, "#") + "%" : "",
         style = side > 0 ? label.style_label_up : label.style_label_down,
         color = color.new(side > 0 ? dUpCol : dDnCol, 55),
         textcolor = side > 0 ? dUpCol : dDnCol,
         size = f_size(mkSize), yloc = yloc.price)

//=============================================================================
// THE DAY'S FRAME
//=============================================================================

var box pzB1 = na
var box pzB2 = na
if intraday and laneOpen and not na(z20u)
    if pzShow
        pzB1 := box.new(time, z25u, time, z20u, xloc = xloc.bar_time,
             border_color = pzBord, bgcolor = pzUp)
        pzB2 := box.new(time, z20d, time, z25d, xloc = xloc.bar_time,
             border_color = pzBord, bgcolor = pzDn)
    if dvShow
        line.new(time, z25u, time, z25d, xloc = xloc.bar_time, extend = extend.both,
             color = dvCol, style = line.style_dotted)
if intraday and inDay and not na(pzB1)
    box.set_right(pzB1, time)
    box.set_right(pzB2, time)

//=============================================================================
// THE FIBS
//
// Levels only, no boxes. State:
//   0  waiting        price has not been in the band during the window
//   1  in the band    waiting for a one-minute close back outside it
//   2  entered        stop and target live
//   3  won
//   4  finished       stopped, or the day ended, or the call went the other way
//=============================================================================

type Fib
    float A
    float T
    int   side
    bool  isSwing
    int   st
    float ent
    line  l62
    line  l70
    line  l79
    line  lst
    line  ltg
    label tag
    label res
    int   lane
    int   t1
    bool  dead

var array<Fib> FS = array.new<Fib>()

// Lines get the whole day at creation. Building them zero-length and relying on
// the per-bar stretch meant that if anything interrupted that loop they stayed
// invisible - which is what happened.
f_fLine(int t1, int t2, float y, color c, int w, string sty) =>
    line.new(t1, y, t2, y, xloc = xloc.bar_time, color = c, width = w,
         style = sty == "dot" ? line.style_dotted : line.style_solid)

f_fNew(float A_, float T_, int sd, bool sw, int t1) =>
    Fib f = Fib.new(A = A_, T = T_, side = sd, isSwing = sw, st = 0,
         ent = f_lv(A_, T_, trEntF), lane = laneDay, t1 = t1, dead = false)
    color c = sw ? fzLnS : fzLnZ
    int t2 = t1 + endHour * 3600000
    f.l62 := f_fLine(t1, t2, f_lv(A_, T_, 0.62), c, fzW, "dot")
    f.l70 := f_fLine(t1, t2, f_lv(A_, T_, 0.70), c, fzW, "dot")
    f.l79 := f_fLine(t1, t2, f_lv(A_, T_, 0.79), c, fzW, "dot")
    f.lst := f_fLine(t1, t2, f_lv(A_, T_, trStpF), fzStpC, fzW, "dot")
    f.ltg := f_fLine(t1, t2, T_, fzTgtC, fzW, "sol")
    if fzNums
        f.tag := label.new(t1, f_lv(A_, T_, 0.70),
             (sw ? "swing" : "zone") + "\n0.62\n0.70\n0.79\n" + trStop + " stop",
             style = label.style_label_right, color = color.new(color.black, 100),
             textcolor = c, size = f_size(fzTxt), xloc = xloc.bar_time)
    array.push(FS, f)
    f

f_fKill(Fib f) =>
    line.delete(f.l62)
    line.delete(f.l70)
    line.delete(f.l79)
    line.delete(f.lst)
    if not na(f.tag)
        label.delete(f.tag)
        f.tag := na

// Build the day's fibs. Zone to zone runs both ways. The swing fib exists only
// in the direction its pivot supports - a pivot low anchors a long, a pivot
// high anchors a short - so on any given day it appears on one side only.
if intraday and laneOpen and not na(z20u)
    if fzZ2Z
        f_fNew(z20d, z20u,  1, false, time)
        f_fNew(z20u, z20d, -1, false, time)
    if fzSw
        bool bothSw = fzSwPick == "Both sides"
        if not na(dayPvH) and (bothSw or not dayPvLast) and z20d < dayPvH
            f_fNew(dayPvH, z20d, -1, true, time)
        if not na(dayPvL) and (bothSw or dayPvLast) and z20u > dayPvL
            f_fNew(dayPvL, z20u,  1, true, time)

// Yesterday's fibs go at the open. A fib that never entered is deleted; one
// that traded stays as the day's record.
if intraday and laneOpen and array.size(FS) > 0
    for i = array.size(FS) - 1 to 0
        Fib o = array.get(FS, i)
        if o.lane != laneDay and o.st < 2
            f_fKill(o)
            line.delete(o.ltg)
            array.remove(FS, i)

//=============================================================================
// THE ENTRY, AND WHAT HAPPENS AFTER IT
//
// The trigger is a ONE MINUTE close back outside the band, taken from the 1m
// series rather than the chart's, so the rule means the same thing whatever
// timeframe the chart is on.
//=============================================================================

array<float> m1c = request.security_lower_tf(syminfo.tickerid, "1", close)

if intraday and array.size(FS) > 0
    for i = 0 to array.size(FS) - 1
        Fib f = array.get(FS, i)
        if f.dead
            continue
        // Direction mode: the other side never trades.
        if trMode == "Direction" and called and side != 0 and f.side != side
            f.st   := 4
            f.dead := true
            f_fKill(f)
            line.delete(f.ltg)
            continue
        float hi62 = math.max(f_lv(f.A, f.T, 0.62), f_lv(f.A, f.T, 0.79))
        float lo79 = math.min(f_lv(f.A, f.T, 0.62), f_lv(f.A, f.T, 0.79))
        float stp  = f_lv(f.A, f.T, trStpF)
        float risk = math.abs(f.ent - stp)
        float rr   = risk > 0 ? math.abs(f.T - f.ent) / risk : 0.0

        if f.st == 0 and inWin and low <= hi62 and high >= lo79
            f.st := 1
        else if f.st == 1
            // a one-minute close back outside the band, on the target side
            // TradingView only serves intrabar data for a limited recent window,
            // so on history the 1m array comes back empty. Requiring it meant no
            // entry could ever confirm on an older bar - no markers, no targets,
            // no trades. Where 1m exists it decides; where it does not, this
            // bar's own close stands in.
            bool closedOut = false
            if inWin
                if array.size(m1c) > 0
                    for k = 0 to array.size(m1c) - 1
                        float c1 = array.get(m1c, k)
                        if f.side > 0 ? c1 > hi62 : c1 < lo79
                            closedOut := true
                            break
                else
                    closedOut := f.side > 0 ? close > hi62 : close < lo79
            bool emaOk = not useEma or (f.side > 0 ? close > ema90 : close < ema90)
            if closedOut and emaOk
                f.st := 2
                line.set_color(f.lst, fzStpC)
                line.set_style(f.lst, line.style_solid)
                label.new(bar_index, f.ent, f.side > 0 ? "▲" : "▼",
                     style = label.style_none, color = color.new(color.black, 100),
                     textcolor = f.side > 0 ? acWinC : acLosC,
                     size = f_size(mkSize), yloc = yloc.price)
            else if not inWin and hour(time, TZ) >= 10
                // the window closed without a confirming close - this fib is done
                f.st   := 4
                f.dead := true
                f_fKill(f)
                line.delete(f.ltg)
        else if f.st == 2
            bool hitT = f.side > 0 ? high >= f.T : low <= f.T
            bool hitS = f.side > 0 ? low <= stp  : high >= stp
            bool count = time >= acFrom
            // the target line runs on until one of them lands
            line.set_x2(f.ltg, time)
            if hitS
                f.st   := 4
                f.dead := true
                stL  += count ? 1 : 0
                stRl += count ? 1.0 : 0.0
                label.new(bar_index, stp, "✕", style = label.style_none,
                     color = color.new(color.black, 100), textcolor = acLosC,
                     size = f_size(mkSize), yloc = yloc.price)
                if acShow
                    f.res := label.new(f.t1, stp, "-1.00R  -$"
                         + str.tostring(acBal * acRisk / 100.0, "#"),
                         style = f.side > 0 ? label.style_label_upper_right
                                            : label.style_label_lower_right,
                         color = color.new(color.black, 100), textcolor = acLosC,
                         size = f_size(mkSize), xloc = xloc.bar_time)
                f_fKill(f)
            else if hitT
                f.st   := 3
                f.dead := true
                stW  += count ? 1 : 0
                stRw += count ? rr : 0.0
                label.new(bar_index, f.T, "●", style = label.style_none,
                     color = color.new(color.black, 100), textcolor = acWinC,
                     size = f_size(mkSize), yloc = yloc.price)
                if acShow
                    f.res := label.new(f.t1, f.T, "+" + str.tostring(rr, "#.##")
                         + "R  +$" + str.tostring(acBal * acRisk / 100.0 * rr, "#"),
                         style = f.side > 0 ? label.style_label_lower_right
                                            : label.style_label_upper_right,
                         color = color.new(color.black, 100), textcolor = acWinC,
                         size = f_size(mkSize), xloc = xloc.bar_time)
                // Optimal keeps only the fib that won
                if trMode == "Optimal"
                    for jj = 0 to array.size(FS) - 1
                        Fib o = array.get(FS, jj)
                        if o.lane == f.lane and jj != i and o.st != 3
                            o.st   := 4
                            o.dead := true
                            f_fKill(o)
                            line.delete(o.ltg)
                            if not na(o.res)
                                label.delete(o.res)
                                o.res := na

//=============================================================================
// PANEL
//=============================================================================

f_cell(table t, int c, int r, string txt, color col, string sz) =>
    table.cell(t, c, r, txt, bgcolor = color.new(color.black, 100),
         text_color = col, text_size = sz,
         text_halign = c == 0 ? text.align_left : text.align_right)

var table T = na

if barstate.islast and pnShow and intraday
    string pos = pnPos == "Top left" ? position.top_left :
         pnPos == "Bottom right" ? position.bottom_right :
         pnPos == "Bottom left" ? position.bottom_left : position.top_right
    if not na(T)
        table.delete(T)
    T := table.new(pos, 2, 7, border_width = 0, frame_width = 0,
         bgcolor = color.new(color.black, 100))
    string sz = f_size(pnSize)
    int   n    = stW + stL
    float totR = stRw - stRl
    float pnl  = acBal * acRisk / 100.0 * totR
    color fg   = color.new(#c8d4de, 12)
    color dim  = color.new(#c8d4de, 52)
    f_cell(T, 0, 0, "W / L", dim, sz)
    f_cell(T, 1, 0, str.tostring(stW) + " / " + str.tostring(stL), fg, sz)
    f_cell(T, 0, 1, "win rate", dim, sz)
    f_cell(T, 1, 1, n == 0 ? "-" : str.tostring(100.0 * stW / n, "#.#") + "%", fg, sz)
    f_cell(T, 0, 2, "total R", dim, sz)
    f_cell(T, 1, 2, (totR >= 0 ? "+" : "") + str.tostring(totR, "#.#"),
         totR >= 0 ? acWinC : acLosC, sz)
    f_cell(T, 0, 3, "P&L", dim, sz)
    f_cell(T, 1, 3, (pnl >= 0 ? "+$" : "-$") + str.tostring(math.abs(pnl), "#"),
         pnl >= 0 ? acWinC : acLosC, sz)
    f_cell(T, 0, 4, "avg R", dim, sz)
    f_cell(T, 1, 4, n == 0 ? "-" : (totR / n >= 0 ? "+" : "")
         + str.tostring(totR / n, "0.00"), fg, sz)
    f_cell(T, 0, 5, "avg win", dim, sz)
    f_cell(T, 1, 5, stW == 0 ? "-" : "+" + str.tostring(stRw / stW, "0.00") + "R", fg, sz)
    f_cell(T, 0, 6, "call", dim, sz)
    f_cell(T, 1, 6, stCallN == 0 ? "-" : str.tostring(100.0 * stCallW / stCallN, "#.#")
         + "%  " + str.tostring(stCallN), fg, sz)

//=============================================================================
// ALERTS
//=============================================================================

alertcondition(justCalled and side ==  1, "Direction: UP",   "Direction call: UP")
alertcondition(justCalled and side == -1, "Direction: DOWN", "Direction call: DOWN")
