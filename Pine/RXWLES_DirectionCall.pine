//@version=6
// ============================================================================
// RXWLES DIRECTION CALL  v4.0
//
// Rebuilt around one engine. Everything up to v3.6 carried the original VWAP
// trade engine alongside the fib zones - two systems drawing at once, which is
// where the stray TP/SL tags, the second set of entry markers and the target
// sitting on 2.45 instead of 2.0 were all coming from. The old engine is gone.
//
// What is left is a single idea, drawn once per day and locked to that day:
//
//   ANCHOR   the 1 sits on a fixed reference - today's opposing 2.0 edge, the
//            Asia extreme, yesterday's last swing, or yesterday's 2.0 edge
//   TARGET   the -0.27 sits on the projection edge in that direction
//   ENTRY    a fib level between them, 0.62 / 0.70 / 0.79
//   STOP     0.88 / 0.95 / the 1 anchor
//
//   price(f) = A + (1 - f) / 1.27 x (T - A)
//
// Measured over 3,482-3,673 trades, 2004-2026, anchored to yesterday's swing:
//
//   entry   0.62  PF 1.15      stop  0.88  PF 1.16      target  2.0  PF 1.14
//           0.70  PF 1.14            0.95  PF 1.14              2.5  PF 1.10
//           0.79  PF 1.14            1.00  PF 1.05
//
// 0.95 wins on both samples: 0.88 halves the win rate, the 1 anchor doubles
// drawdown. The direction call itself is 72.5% on 2,597 undecided sessions.
//
// A zone's life, and its look follows it:
//   DORMANT  a muted fill and a faint border
//   LIVE     price inside - lighter fill, the three levels appear
//   ARMED    price left the way it came - the stop and target lines appear
//   WON      the target traded - the result prints inside the day
//   SPENT    price closed through - finished, and it cannot re-arm
// ============================================================================

indicator("RXWLES Direction Call", "DirCall", overlay = true,
     max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

const string TZ = "America/New_York"

//=============================================================================
// INPUTS
//=============================================================================

srcHour  = input.int(21, "Source candle hour (NY)", minval = 0, maxval = 23,
     group = "Method", tooltip = "Must match RXWLES PRO's Enigma Source Hour.")
readHour = input.int(4, "Direction read hour (NY)", minval = 0, maxval = 23,
     group = "Method")
endHour  = input.int(17, "Day block ends (NY hour)", minval = 1, maxval = 24,
     group = "Method",
     tooltip = "Everything for a day is locked between midnight and this hour. " +
               "Nothing runs into the next day, including results.")

trMode  = input.string("Optimal", "Mode", group = "Trade",
     options = ["Direction engine", "Optimal"],
     tooltip = "Direction engine trades only the side the read-hour call names. " +
               "Optimal lets either side arm and keeps whichever target trades " +
               "first. Optimal reads better than it trades - it settles the side " +
               "after the fact, which you cannot do live.")
trEntry = input.string("0.62", "Entry fib", options = ["0.62", "0.70", "0.79"],
     group = "Trade", tooltip = "MT5 PF: 0.62 1.15, 0.70 1.14, 0.79 1.14.")
trStop  = input.string("0.95", "Stop fib", options = ["0.88", "0.95", "1.00"],
     group = "Trade", tooltip = "MT5 PF: 0.88 1.16, 0.95 1.14, 1.00 1.05. " +
               "0.88 halves the win rate, the 1 anchor doubles drawdown.")
trTgt   = input.string("2.0", "Target edge", options = ["2.0", "2.5"],
     group = "Trade", tooltip = "MT5 PF: 2.0 1.14, 2.5 1.10.")
trBoth  = input.bool(true, "Draw both sides", group = "Trade")

fzA1 = input.bool(true,  "Today's zone edge", inline = "fa", group = "Anchors")
fzA2 = input.bool(true,  "Asia",              inline = "fa", group = "Anchors")
fzA3 = input.bool(true,  "Yesterday's swing", inline = "fb", group = "Anchors")
fzA4 = input.bool(false, "Yesterday's zone",  inline = "fb", group = "Anchors",
     tooltip = "Off by default - 0 for 12 in the 2026 sample and the only anchor " +
               "negative over the full history.")
fzPiv   = input.int(5, "Swing strength", minval = 1, maxval = 30, group = "Anchors")
fzSwSrc = input.string("Last swing before the day", "Which swing", group = "Anchors",
     options = ["Last swing before the day", "Deepest swing of the previous day"])
fzAsiaW = input.string("19:00 - 00:00", "Asia window (NY)", group = "Anchors",
     options = ["19:00 - 00:00", "18:00 - 00:00", "20:00 - 02:00", "19:00 - 02:00"])

fzTheme = input.string("Dark", "Theme", options = ["Dark", "Light grey", "White"],
     group = "Look")
fzDorm  = input.color(color.new(#8899a6, 93), "Dormant fill",  inline = "l1", group = "Look")
fzDormB = input.color(color.new(#8899a6, 82), "border",        inline = "l1", group = "Look")
fzLive  = input.color(color.new(#b8c6d1, 85), "Live fill",     inline = "l2", group = "Look")
fzEdge  = input.color(color.new(#b8c6d1, 60), "border",        inline = "l2", group = "Look")
fzWonF  = input.color(color.new(#4db6a0, 94), "Won fill",      inline = "l3", group = "Look")
fzWonB  = input.color(color.new(#4db6a0, 72), "border",        inline = "l3", group = "Look")
fzLine  = input.color(color.new(#c8d4de, 55), "Level lines",   inline = "l4", group = "Look")
fzTgtC  = input.color(color.new(#8fb3a8, 50), "Target",        inline = "l4", group = "Look")
fzStpC  = input.color(color.new(#c08a8a, 50), "Stop",          inline = "l4", group = "Look")
fzTxt   = input.string("Tiny", "Level text", options = ["Tiny", "Small", "Normal"],
     group = "Look")
fzShowN = input.bool(true, "Level numbers when live", group = "Look")

eeShow  = input.bool(true, "End-to-end box", inline = "e1", group = "End to end")
eeFill  = input.color(color.new(#8899a6, 96), "fill",   inline = "e1", group = "End to end")
eeBord  = input.color(color.new(#a8b8c4, 78), "border", inline = "e1", group = "End to end")
eeEdge  = input.color(color.new(#b8c6d1, 55), "2.0 edges", inline = "e2", group = "End to end")

dvShow  = input.bool(true, "Midnight divider", inline = "dv", group = "Divider")
dvCol   = input.color(color.new(#8899a6, 85), "", inline = "dv", group = "Divider")
dvStyle = input.string("Dotted", "", options = ["Solid", "Dashed", "Dotted"],
     inline = "dv", group = "Divider")

dShow   = input.bool(true, "Direction marker", inline = "d1", group = "Marker")
dUpCol  = input.color(color.new(#4db6a0, 35), "up",   inline = "d1", group = "Marker")
dDnCol  = input.color(color.new(#c96a6a, 35), "down", inline = "d1", group = "Marker")
dSize   = input.string("Tiny", "size", inline = "d2", group = "Marker",
     options = ["Tiny", "Small", "Normal"])
dConf   = input.bool(true, "confidence %", inline = "d2", group = "Marker")
dConfC  = input.color(color.new(#8899a6, 35), "", inline = "d2", group = "Marker")
dOff    = input.float(0.25, "Offset (R)", step = 0.05, minval = 0.0, group = "Marker")

acBal   = input.float(500.0, "Account balance ($)", minval = 1, group = "Risk")
acRisk  = input.float(0.5, "Risk per trade (%)", minval = 0.01, step = 0.05, group = "Risk")
acFrom  = input.time(timestamp("2026-01-01 00:00 -0500"), "Track from", group = "Risk")
acShow  = input.bool(true, "Print results on the chart", group = "Risk")
acSize  = input.string("Tiny", "Result text", options = ["Tiny", "Small", "Normal"],
     group = "Risk")
acWinC  = input.color(#4db6a0, "win", inline = "ac", group = "Risk")
acLosC  = input.color(#c96a6a, "loss", inline = "ac", group = "Risk")

pnShow  = input.bool(true, "Show panel", group = "Panel")
pnPos   = input.string("Top right", "Position", group = "Panel",
     options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"])
pnSize  = input.string("Tiny", "Text", options = ["Tiny", "Small", "Normal"],
     group = "Panel")

//=============================================================================
// HELPERS
//=============================================================================

f_size(string s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : s == "Large" ? size.large :
     s == "Huge" ? size.huge : size.small

f_style(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

f_theme(color c) =>
    fzTheme == "Dark" ? c :
     color.new(fzTheme == "Light grey" ? #4a5a66 : #2b3740, color.t(c))

f_lv(float a_, float t_, float f) => a_ + (1.0 - f) / 1.27 * (t_ - a_)

f_midnight(int t) =>
    timestamp(TZ, year(t, TZ), month(t, TZ), dayofmonth(t, TZ), 0, 0, 0)

float trEntF = str.tonumber(trEntry)
float trStpF = str.tonumber(trStop)
float trTgtM = str.tonumber(trTgt)

//=============================================================================
// SOURCE CANDLE, LANE, AND THE REFERENCES THE ANCHORS COME FROM
//=============================================================================

bool intraday = not timeframe.isdwm

var float srcHigh = na
var float srcLow  = na
var int   srcDay  = na
if intraday and hour(time[1], TZ) == srcHour
    srcHigh := na(srcHigh) or hour(time[2], TZ) != srcHour ? high[1] : math.max(srcHigh, high[1])
    srcLow  := na(srcLow)  or hour(time[2], TZ) != srcHour ? low[1]  : math.min(srcLow,  low[1])
    srcDay  := f_midnight(f_midnight(time[1]) + 26 * 3600000)

var int   laneDay = na
var float boxHi   = na
var float boxLo   = na
var float R       = na
var float z20u    = na
var float z20d    = na
var float pz20u   = na
var float pz20d   = na
var int   side    = 0
var bool  called  = false

// running record, from the account start date
var int   stW     = 0
var int   stL     = 0
var float stRw    = 0.0
var float stRl    = 0.0
var int   stCallW = 0
var int   stCallN = 0
var int   lastLoss = 0

bool newSrc = intraday and not na(srcDay) and not na(srcHigh)
     and (na(laneDay) or srcDay != laneDay)

if newSrc and (srcHigh - srcLow) > 0
    // This block runs at 22:00, an hour before the lane opens, so yesterday's
    // 2.0 pair is banked here before the new one overwrites it.
    pz20u   := z20u
    pz20d   := z20d
    laneDay := srcDay
    boxHi   := srcHigh
    boxLo   := srcLow
    R       := srcHigh - srcLow
    z20u    := srcHigh + 2.0 * R
    z20d    := srcLow  - 2.0 * R
    called  := false
    side    := 0

bool laneOpen = intraday and not na(laneDay) and time >= laneDay and time[1] < laneDay
bool inLane   = intraday and not na(laneDay) and time >= laneDay
     and time < laneDay + 86400000
bool inBlock  = inLane and hour(time, TZ) < endHour

var float laneHi  = na
var float laneLo  = na
var float pvHi    = na
var float pvLo    = na
var float dayPvHi = na
var float dayPvLo = na
var float asHi    = na
var float asLo    = na
var float asiaHi  = na
var float asiaLo  = na

// Asia accumulates while its window is open and freezes on the bar it closes,
// which handles both the windows that end at midnight and those that run past.
int asH = hour(time, TZ)
bool inAsia = fzAsiaW == "18:00 - 00:00" ? (asH >= 18) :
     fzAsiaW == "20:00 - 02:00"          ? (asH >= 20 or asH < 2) :
     fzAsiaW == "19:00 - 02:00"          ? (asH >= 19 or asH < 2) : (asH >= 19)
if intraday
    if inAsia and not inAsia[1]
        asHi := high
        asLo := low
    else if inAsia
        asHi := math.max(nz(asHi, high), high)
        asLo := math.min(nz(asLo, low),  low)
    else if inAsia[1]
        asiaHi := asHi
        asiaLo := asLo

// Pivots confirm fzPiv bars after the fact, so what is read is already settled.
float _ph = ta.pivothigh(high, fzPiv, fzPiv)
float _pl = ta.pivotlow(low,  fzPiv, fzPiv)
if not na(_ph)
    pvHi := _ph
if not na(_pl)
    pvLo := _pl

if laneOpen
    dayPvHi := fzSwSrc == "Deepest swing of the previous day" ? laneHi : pvHi
    dayPvLo := fzSwSrc == "Deepest swing of the previous day" ? laneLo : pvLo
    laneHi  := high
    laneLo  := low
else if inLane
    laneHi := na(laneHi) ? high : math.max(laneHi, high)
    laneLo := na(laneLo) ? low  : math.min(laneLo, low)

//=============================================================================
// THE CALL, AND THE CONFIDENCE THAT GOES WITH IT
//
// The score is how lopsided the call is - where the reading price sits between
// the two 2.0 edges, as a distance from dead centre. Measured on 4,449 sessions,
// 2004-2026: 57.7% at the midpoint rising to 94.9% at the extreme.
//=============================================================================

var float cfRaw  = na
var float cfHit  = na
var int   cfTier = 0

f_cfHit(float raw) =>
    raw < 0.05 ? 57.7 : raw < 0.10 ? 64.0 : raw < 0.15 ? 68.2 :
     raw < 0.20 ? 74.8 : raw < 0.25 ? 78.4 : raw < 0.35 ? 81.3 : 94.9

if inLane and not called and not na(R) and R > 0 and hour(time, TZ) >= readHour
    called := true
    float pz = (open - z20d) / (z20u - z20d)
    cfRaw  := math.abs(pz - 0.5)
    cfHit  := f_cfHit(cfRaw)
    cfTier := cfRaw < 0.10 ? 1 : cfRaw < 0.20 ? 2 : cfRaw < 0.30 ? 3 : 4
    side   := pz > 0.5 ? 1 : -1

bool justCalled = inLane and called and not called[1]

// the call's own record, settled the moment either 2.0 edge trades
var int  clSide = 0
var bool clOpen = false
if justCalled and side != 0 and time >= acFrom
    clSide := side
    clOpen := true
if clOpen and not na(z20u)
    bool hu = high >= z20u
    bool hd = low  <= z20d
    if hu or hd
        stCallN += 1
        stCallW += ((hu and clSide > 0) or (hd and clSide < 0)) ? 1 : 0
        clOpen  := false

if dShow and justCalled and side != 0 and not na(R)
    label.new(bar_index, side > 0 ? low - dOff * R : high + dOff * R, "",
         style = side > 0 ? label.style_triangleup : label.style_triangledown,
         color = side > 0 ? dUpCol : dDnCol, size = f_size(dSize), yloc = yloc.price)
    if dConf and not na(cfHit)
        label.new(bar_index, side > 0 ? low - (dOff + 0.30) * R
                                      : high + (dOff + 0.30) * R,
             str.tostring(cfHit, "#") + "%", style = label.style_none,
             color = color.new(color.black, 100), textcolor = dConfC,
             size = f_size(dSize), yloc = yloc.price)

//=============================================================================
// THE ZONES
//
// Each zone owns its own left and right edge, fixed to the day it belongs to.
// Nothing a zone draws - lines, levels, results - ever leaves that day's block,
// however long the trade itself takes to resolve.
//=============================================================================

type Zone
    float A
    float T
    int   side
    int   st        // 0 dormant  1 live  2 armed  3 won  4 spent
    box   bx
    line  l1
    line  l2
    line  l3
    line  ls
    line  lt
    label tag
    label res
    int   lane
    int   x1
    int   x2
    bool  dead

var array<Zone> ZS = array.new<Zone>()

f_zNew(float A_, float T_, int sd, int x1) =>
    Zone z = Zone.new(A_, T_, sd, 0, na, na, na, na, na, na, na, laneDay, x1, x1, false)
    float u = f_lv(A_, T_, 0.62)
    float d = f_lv(A_, T_, 0.79)
    z.bx := box.new(x1, math.max(u, d), x1, math.min(u, d),
         border_color = f_theme(fzDormB), bgcolor = f_theme(fzDorm),
         xloc = xloc.bar_index)
    array.push(ZS, z)
    z

f_zLevels(Zone z) =>
    color c = f_theme(fzLine)
    z.l1 := line.new(z.x1, f_lv(z.A, z.T, 0.62), z.x2, f_lv(z.A, z.T, 0.62),
         xloc = xloc.bar_index, color = c, style = line.style_dotted)
    z.l2 := line.new(z.x1, f_lv(z.A, z.T, 0.70), z.x2, f_lv(z.A, z.T, 0.70),
         xloc = xloc.bar_index, color = c, style = line.style_dotted)
    z.l3 := line.new(z.x1, f_lv(z.A, z.T, 0.79), z.x2, f_lv(z.A, z.T, 0.79),
         xloc = xloc.bar_index, color = c, style = line.style_dotted)
    if fzShowN
        z.tag := label.new(z.x1, f_lv(z.A, z.T, 0.70), "0.62\n0.70\n0.79",
             style = label.style_label_right, color = color.new(color.black, 100),
             textcolor = c, size = f_size(fzTxt), xloc = xloc.bar_index)

f_zRecolour(Zone z) =>
    if z.st == 0 or z.st == 4
        box.set_bgcolor(z.bx, f_theme(fzDorm))
        box.set_border_color(z.bx, f_theme(fzDormB))
    else if z.st == 1
        box.set_bgcolor(z.bx, f_theme(fzLive))
        box.set_border_color(z.bx, f_theme(fzEdge))
    else
        // A won zone is a hue, not a highlight. The levels stay grey.
        box.set_bgcolor(z.bx, f_theme(fzWonF))
        box.set_border_color(z.bx, f_theme(fzWonB))

f_zStrip(Zone z) =>
    if not na(z.l1)
        line.delete(z.l1)
        line.delete(z.l2)
        line.delete(z.l3)
        z.l1 := na
    if not na(z.tag)
        label.delete(z.tag)
        z.tag := na
    if not na(z.ls)
        line.delete(z.ls)
        z.ls := na
    if not na(z.lt)
        line.delete(z.lt)
        z.lt := na

// Once the day's trade is settled, every other zone on that lane stops.
f_zSole(int lane, int keep) =>
    for jj = 0 to array.size(ZS) - 1
        Zone o = array.get(ZS, jj)
        if o.lane == lane and jj != keep and o.st != 3 and not o.dead
            o.st   := 4
            o.dead := true
            f_zStrip(o)
            f_zRecolour(o)
            if not na(o.res)
                label.delete(o.res)
                o.res := na

f_zSpawn(float A_, int sd) =>
    if not na(A_) and not na(R) and R > 0
        float T_ = sd > 0 ? (boxHi + trTgtM * R) : (boxLo - trTgtM * R)
        float z_ = sd > 0 ? z20u : z20d          // the fib is always built to 2.0
        if (sd > 0 and z_ - A_ > 0) or (sd < 0 and z_ - A_ < 0)
            f_zNew(A_, T_, sd, bar_index)

if intraday and laneOpen and not na(z20u)
    int only = 1
    for k = 0 to (trBoth ? 1 : 0)
        int sd = trBoth ? (k == 0 ? 1 : -1) : only
        if fzA1
            f_zSpawn(sd > 0 ? z20d : z20u, sd)
        if fzA2
            f_zSpawn(sd > 0 ? asiaLo : asiaHi, sd)
        if fzA3
            f_zSpawn(sd > 0 ? dayPvLo : dayPvHi, sd)
        if fzA4
            f_zSpawn(sd > 0 ? pz20d : pz20u, sd)

// the midnight divider and the end-to-end frame, on the same bar the day starts
var box  eeBx = na
var line eeUp = na
var line eeDn = na
if intraday and laneOpen and not na(z20u)
    if dvShow
        line.new(bar_index, z20u, bar_index, z20d, xloc = xloc.bar_index,
             extend = extend.both, color = dvCol, style = f_style(dvStyle))
    if eeShow
        eeBx := box.new(bar_index, z20u, bar_index, z20d, border_color = eeBord,
             bgcolor = eeFill, xloc = xloc.bar_index)
        eeUp := line.new(bar_index, z20u, bar_index, z20u, xloc = xloc.bar_index,
             color = eeEdge)
        eeDn := line.new(bar_index, z20d, bar_index, z20d, xloc = xloc.bar_index,
             color = eeEdge)

if intraday and inBlock and not na(eeBx)
    box.set_right(eeBx, bar_index)
    line.set_x2(eeUp, bar_index)
    line.set_x2(eeDn, bar_index)

//=============================================================================
// THE STATE MACHINE
//
// A zone's drawings stop at the end of its own day block. The trade itself can
// still resolve later - a target hit on the following morning still counts, and
// its result still prints inside the day the setup came from.
//=============================================================================

if intraday and array.size(ZS) > 0
    for i = 0 to array.size(ZS) - 1
        Zone z = array.get(ZS, i)
        if z.dead
            continue
        // the right edge grows only while its own day is still running
        if z.lane == laneDay and inBlock
            z.x2 := bar_index
            box.set_right(z.bx, z.x2)
            if not na(z.l1)
                line.set_x2(z.l1, z.x2)
                line.set_x2(z.l2, z.x2)
                line.set_x2(z.l3, z.x2)
            if not na(z.ls)
                line.set_x2(z.ls, z.x2)
            if not na(z.lt)
                line.set_x2(z.lt, z.x2)
        // Direction-engine mode: once the call is in, the other side stops. Both
        // sides stay drawn so the map is complete; only the called side trades.
        if trMode == "Direction engine" and z.lane == laneDay and called and side != 0
             and z.side != side
            z.st   := 4
            z.dead := true
            f_zStrip(z)
            f_zRecolour(z)
            continue
        float hi  = math.max(f_lv(z.A, z.T, 0.62), f_lv(z.A, z.T, 0.79))
        float lo  = math.min(f_lv(z.A, z.T, 0.62), f_lv(z.A, z.T, 0.79))
        float ent = f_lv(z.A, z.T, trEntF)
        float stp = f_lv(z.A, z.T, trStpF)
        float risk = math.abs(ent - stp)
        float rr   = risk > 0 ? math.abs(z.T - ent) / risk : 0.0
        bool touch = low <= hi and high >= lo
        if z.st == 0 and touch
            z.st := 1
            f_zLevels(z)
            f_zRecolour(z)
        else if z.st == 1
            bool through = z.side > 0 ? close < lo : close > hi
            bool backOut = z.side > 0 ? low > hi : high < lo
            if through
                // Closed through: finished. Price returning later cannot re-arm
                // it - only a zone that was respected can be entered.
                z.st   := 4
                z.dead := true
                f_zStrip(z)
                f_zRecolour(z)
            else if backOut
                z.st := 2
                f_zRecolour(z)
                z.ls := line.new(z.x1, stp, z.x2, stp, xloc = xloc.bar_index,
                     color = fzStpC)
                z.lt := line.new(z.x1, z.T, z.x2, z.T, xloc = xloc.bar_index,
                     color = fzTgtC)
        else if z.st == 2
            bool hitT  = z.side > 0 ? high >= z.T : low <= z.T
            bool hitS  = z.side > 0 ? low <= stp : high >= stp
            bool count = time >= acFrom
            if hitS
                // Both sides are taken by design, so one stopping is the side you
                // would not have chosen. A lane books a loss only once every zone
                // on it is gone with no target reached.
                z.st   := 4
                z.dead := true
                f_zStrip(z)
                f_zRecolour(z)
                bool anyAlive = false
                bool anyWon   = false
                for jj = 0 to array.size(ZS) - 1
                    Zone o = array.get(ZS, jj)
                    if o.lane == z.lane
                        anyWon   := anyWon or o.st == 3
                        anyAlive := anyAlive or not o.dead
                if not anyAlive and not anyWon and count and lastLoss != z.lane
                    lastLoss := z.lane
                    stL  += 1
                    stRl += 1.0
                    if acShow
                        z.res := label.new(z.x1, stp, "-1.00R  -$"
                             + str.tostring(acBal * acRisk / 100.0, "#.##"),
                             style = z.side > 0 ? label.style_label_upper_right
                                                : label.style_label_lower_right,
                             color = color.new(color.black, 100), textcolor = acLosC,
                             size = f_size(acSize), xloc = xloc.bar_index)
            else if hitT
                stW  += count ? 1 : 0
                stRw += count ? rr : 0.0
                z.st   := 3
                z.dead := true
                f_zRecolour(z)
                f_zSole(z.lane, i)
                if acShow
                    z.res := label.new(z.x1, z.T, "+" + str.tostring(rr, "#.##")
                         + "R  +$" + str.tostring(acBal * acRisk / 100.0 * rr, "#.##"),
                         style = z.side > 0 ? label.style_label_lower_right
                                            : label.style_label_upper_right,
                         color = color.new(color.black, 100), textcolor = acWinC,
                         size = f_size(acSize), xloc = xloc.bar_index)

//=============================================================================
// PANEL
//=============================================================================

var table T = na

// Pine wants functions at top level, so the cell helper takes the table and the
// size rather than closing over them.
f_cell(table t, int c, int r, string txt, color col, string sz) =>
    table.cell(t, c, r, txt, bgcolor = color.new(color.black, 100),
         text_color = col, text_size = sz,
         text_halign = c == 0 ? text.align_left : text.align_right)

if barstate.islast and pnShow and intraday
    string pos = pnPos == "Top left" ? position.top_left :
         pnPos == "Bottom right" ? position.bottom_right :
         pnPos == "Bottom left" ? position.bottom_left :
         pnPos == "Middle right" ? position.middle_right : position.top_right
    if not na(T)
        table.delete(T)
    T := table.new(pos, 2, 7, border_width = 0, frame_width = 0,
         bgcolor = color.new(color.black, 100))
    string sz = f_size(pnSize)
    int   n    = stW + stL
    float totR = stRw - stRl
    float pnl  = acBal * acRisk / 100.0 * totR
    color fg   = color.new(#c8d4de, 12)
    color dim  = color.new(#c8d4de, 52)

    f_cell(T, 0, 0, "W / L", dim, sz)
    f_cell(T, 1, 0, str.tostring(stW) + " / " + str.tostring(stL), fg, sz)
    f_cell(T, 0, 1, "win rate", dim, sz)
    f_cell(T, 1, 1, n == 0 ? "-" : str.tostring(100.0 * stW / n, "#.#") + "%", fg, sz)
    f_cell(T, 0, 2, "total R", dim, sz)
    f_cell(T, 1, 2, (totR >= 0 ? "+" : "") + str.tostring(totR, "#.#"),
         totR >= 0 ? acWinC : acLosC, sz)
    f_cell(T, 0, 3, "P&L", dim, sz)
    f_cell(T, 1, 3, (pnl >= 0 ? "+$" : "-$") + str.tostring(math.abs(pnl), "#.##"),
         pnl >= 0 ? acWinC : acLosC, sz)
    f_cell(T, 0, 4, "avg R", dim, sz)
    f_cell(T, 1, 4, n == 0 ? "-" : (totR / n >= 0 ? "+" : "")
         + str.tostring(totR / n, "0.00"), fg, sz)
    f_cell(T, 0, 5, "avg win", dim, sz)
    f_cell(T, 1, 5, stW == 0 ? "-" : "+" + str.tostring(stRw / stW, "0.00") + "R", fg, sz)
    f_cell(T, 0, 6, "call", dim, sz)
    f_cell(T, 1, 6, stCallN == 0 ? "-" : str.tostring(100.0 * stCallW / stCallN, "#.#")
         + "%  " + str.tostring(stCallN), fg, sz)

//=============================================================================
// ALERTS
//=============================================================================

alertcondition(justCalled and side ==  1, "Direction: UP",   "Direction call: UP")
alertcondition(justCalled and side == -1, "Direction: DOWN", "Direction call: DOWN")
alertcondition(justCalled and cfTier >= 3, "Confidence: strong",
     "A strong call - the reading is in the top two tiers")
alertcondition(justCalled and cfTier <= 1, "Confidence: weak",
     "A weak call - close to a coin flip")
