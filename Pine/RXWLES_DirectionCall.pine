sStop   = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = "s", group = "Levels")
wStop   = input.int(2, "", minval = 1, maxval = 4, inline = "s", group = "Levels")

shTgt   = input.bool(true, "Target", inline = "t", group = "Levels")
cTgt    = input.color(#00e676, "", inline = "t", group = "Levels")
sTgt    = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = "t", group = "Levels")
wTgt    = input.int(2, "", minval = 1, maxval = 4, inline = "t", group = "Levels")

shBE    = input.bool(true, "Break-even trigger (when enabled)", inline = "b", group = "Levels")
cBE     = input.color(#ffab00, "", inline = "b", group = "Levels")
sBE     = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], inline = "b", group = "Levels")

shVwap  = input.bool(true, "VWAP while waiting", inline = "v", group = "Levels")
cVwap   = input.color(color.new(#ffffff, 0), "", inline = "v", group = "Levels")

priceTag = input.bool(true, "Price tag on each level", group = "Levels")
tagSize  = input.string("Tiny", "Tag size", options = ["Tiny", "Small", "Normal"], group = "Levels")

//-----------------------------------------------------------------------------
// CONFIDENCE DASHBOARD
//
// The score is how lopsided the call is: where the reading price sits between
// the two 2.0 zone edges, measured as the distance from dead centre. It is the
// only thing found in 4,449 sessions of 15m gold, 2004-2026, that predicts
// whether the call is right - and it does so cleanly and monotonically.
//
//   |pos-0.5|      n     hit rate     2005-17   2018-26   2023-26
//   0.00 - 0.05   402      57.7%       53.96%    61.50%    63.38%
//   0.05 - 0.10   442      64.0%       63.80%    64.42%    66.07%
//   0.10 - 0.15   377      68.2%       69.08%    67.06%    61.54%
//   0.15 - 0.20   341      74.8%       72.11%    78.15%    77.97%
//   0.20 - 0.25   282      78.4%       76.39%    80.43%    79.17%
//   0.25 - 0.35   411      81.3%       82.70%    79.31%    81.01%
//   0.35 +        156      94.9%       96.55%    92.75%    96.88%
//
// The confluence grid adds today's 9pm range divided by yesterday's full lane
// range. A bigger box against yesterday means a better call, at every level of
// lopsidedness, and the effect holds out of sample (+4.0pp on 2018-26):
//
//                     conf<0.10   0.10-0.20   0.20-0.30   conf>=0.30
//   Q1 box smallest     55.9%       69.0%       76.8%       85.9%
//   Q2                  58.8%       69.0%       76.5%       79.5%
//   Q3                  60.4%       70.5%       79.8%       94.3%
//   Q4 box largest      68.3%       75.8%       83.6%       92.6%
//
// These are measured historical rates on this instrument, not a forecast. The
// dashboard fires at the read hour every single day, whatever the trade engine
// is doing - an open position from yesterday never suppresses it.
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// FIB ZONES
//
// Every zone is the same construction: -0.27 pinned to a 2.0 projection edge,
// the 1 on a fixed reference. Both directions are drawn, so the flipped side is
// always on the chart if you disagree with the call.
//
//   price(f) = A + (1 - f) / 1.27 x (T - A)
//   0.62 -> 2.34:1   0.70 -> 3.23:1   0.79 -> 5.05:1   with the stop on the 1
//
// Measured on 3,294 trades over 22 years and again on the OANDA-matched window,
// the 0.95 stop beat both the 0.88 and the 1 anchor. 0.88 collapses the win
// rate, the 1 anchor roughly doubles drawdown.
//
// A zone moves through five states and its look follows the state:
//
//   DORMANT  a muted fill, nothing else
//   LIVE     price is inside it - lighter fill, faint border, the three levels
//   ARMED    price left the way it came - levels turn green, the stop appears
//   WON      the target traded - the result prints
//   SPENT    price closed through it - back to dormant, sunk into the chart
//-----------------------------------------------------------------------------

fzOn    = input.bool(true, "Draw the fib zones", group = "Fib zones")
fzTheme = input.string("Dark", "Theme", options = ["Dark", "Light grey", "White"],
     group = "Fib zones",
     tooltip = "Sets the whole palette. Every colour below can still be overridden.")
fzBoth  = input.bool(true, "Draw both sides of the market", group = "Fib zones",
     tooltip = "On: the call's side and the flipped side. Off: the call's side only.")
fzEndH  = input.int(17, "Boxes run to (NY hour)", minval = 1, maxval = 24,
     group = "Fib zones",
     tooltip = "Midnight to this hour. 17 keeps the day's block tight; 24 runs " +
               "midnight to midnight so the blocks butt up against each other.")

fzA1 = input.bool(true,  "Today's zone edge",   inline = "fa", group = "Fib zones")
fzA2 = input.bool(true,  "Asia",                inline = "fa", group = "Fib zones")
fzA3 = input.bool(true,  "Yesterday's swing",   inline = "fb", group = "Fib zones")
fzA4 = input.bool(false, "Yesterday's zone",    inline = "fb", group = "Fib zones",
     tooltip = "Off by default. It went 0 for 12 in the 2026 sample and is the " +
               "only anchor negative over the full history.")
fzPiv = input.int(5, "Swing strength", minval = 1, maxval = 30, group = "Fib zones",
     tooltip = "Bars either side needed for a pivot to confirm. Bigger means " +
               "fewer, more significant swings.")
fzSwSrc = input.string("Last swing before the lane opened", "Which swing",
     group = "Fib zones",
     options = ["Last swing before the lane opened", "Deepest swing of the previous day"])
fzAsiaW = input.string("19:00 - 00:00", "Asia window (NY)", group = "Fib zones",
     options = ["19:00 - 00:00", "18:00 - 00:00", "20:00 - 02:00", "19:00 - 02:00"])

//--- palette ---------------------------------------------------------------
fzDorm  = input.color(color.new(#8899a6, 92), "Dormant fill",  inline = "p1", group = "Fib look")
fzLive  = input.color(color.new(#b8c6d1, 82), "Live fill",     inline = "p1", group = "Fib look")
fzEdge  = input.color(color.new(#b8c6d1, 55), "Live border",   inline = "p2", group = "Fib look")
fzLine  = input.color(color.new(#c8d4de, 45), "Level lines",   inline = "p2", group = "Fib look")
fzWin   = input.color(color.new(#4db6a0, 45), "Won border",    inline = "p3", group = "Fib look")
fzDormB = input.color(color.new(#8899a6, 78), "Dormant border", inline = "p3", group = "Fib look")
fzWonF  = input.color(color.new(#4db6a0, 90), "Won fill",      inline = "p4", group = "Fib look")
fzWonL  = input.color(color.new(#c8d4de, 40), "Won levels",    inline = "p4", group = "Fib look")
fzTgtC  = input.color(color.new(#8fb3a8, 45), "Target line",   inline = "p5", group = "Fib look")
fzStpC  = input.color(color.new(#c08a8a, 45), "Stop line",     inline = "p5", group = "Fib look")
fzLnW   = input.int(1, "their width", minval = 1, maxval = 3, inline = "p5", group = "Fib look")

eeShow  = input.bool(true, "Draw the end-to-end zone box", group = "End to end")
eeFill  = input.color(color.new(#8899a6, 95), "fill",   inline = "ee", group = "End to end")
eeBord  = input.color(color.new(#a8b8c4, 70), "border", inline = "ee", group = "End to end")
eeW     = input.int(1, "border width", minval = 1, maxval = 3, inline = "ee", group = "End to end")
eeEdge  = input.color(color.new(#b8c6d1, 45), "2.0 edge lines", inline = "e2", group = "End to end")
eeEdgeW = input.int(1, "width", minval = 1, maxval = 3, inline = "e2", group = "End to end")
fzTxt   = input.string("Tiny", "Level text", options = ["Tiny", "Small", "Normal"],
     group = "Fib look")
fzShowN = input.bool(true, "Show level numbers when live", group = "Fib look")

//--- account ---------------------------------------------------------------
acBal   = input.float(500.0, "Account balance ($)", minval = 1, group = "Risk")
acRisk  = input.float(0.5, "Risk per trade (%)", minval = 0.01, step = 0.05, group = "Risk")
acShow  = input.bool(true, "Print the result on the chart", group = "Risk")
acSize  = input.string("Small", "Result text", options = ["Tiny", "Small", "Normal"],
     group = "Risk")
acWinC  = input.color(#4db6a0, "Win", inline = "ac", group = "Risk")
acLosC  = input.color(#c96a6a, "Loss", inline = "ac", group = "Risk")
acFrom  = input.time(timestamp("2026-01-01 00:00 -0500"), "Track from", group = "Risk",
     tooltip = "Only trades on or after this date count toward the panel.")

cfShow   = input.bool(false, "Show the corner dashboard", group = "Confidence",
     tooltip = "Off by default - the score now sits beside the direction marker.")
cfPos    = input.string("Bottom right", "Position", group = "Confidence",
     options = ["Bottom right", "Bottom left", "Bottom centre", "Top right", "Top left",
                "Middle right", "Middle left"])
cfMode   = input.string("Hit rate", "Score shown", group = "Confidence",
     options = ["Hit rate", "Lopsidedness", "Both"],
     tooltip = "Hit rate = the measured historical accuracy for this reading. " +
               "Lopsidedness = the raw |pos-0.5| number it comes from, 0.00 to 0.50.")
cfGrid   = input.bool(true, "Use the range-ratio confluence grid", group = "Confidence",
     tooltip = "Off = score from lopsidedness alone. On = the two-factor grid, " +
               "which also reads today's 9pm range against yesterday's full range.")

cfDot    = input.string("●", "Circle glyph", group = "Confidence",
     tooltip = "Any character. ● filled, ○ hollow, ⬤ heavy, or an emoji.")
cfDotBy  = input.string("Direction", "Circle colour by", group = "Confidence",
     options = ["Direction", "Confidence tier", "Direction, dimmed when weak"])
cfUpCol  = input.color(#00e676, "Up", inline = "cfd", group = "Confidence")
cfDnCol  = input.color(#ff1744, "Down", inline = "cfd", group = "Confidence")
cfNaCol  = input.color(#78909c, "None yet", inline = "cfd", group = "Confidence")
cfNumCol = input.color(#ffffff, "Score text", group = "Confidence")

cfDotTr  = input.int(0,  "Transparency   circle", minval = 0, maxval = 100,
     inline = "cftr", group = "Confidence")
cfNumTr  = input.int(0,  "score", minval = 0, maxval = 100, inline = "cftr", group = "Confidence")

cfDotSz  = input.string("Huge", "Circle size", inline = "cfsz", group = "Confidence",
     options = ["Tiny", "Small", "Normal", "Large", "Huge"])
cfNumSz  = input.string("Large", "score", inline = "cfsz", group = "Confidence",
     options = ["Tiny", "Small", "Normal", "Large", "Huge"])

cfFloor  = input.float(0.10, "Weak below (lopsidedness)", step = 0.01,
     minval = 0.0, maxval = 0.5, group = "Confidence",
     tooltip = "Below 0.10 the call ran 55.9% to 68.3% - close to a coin flip, " +
               "and that is roughly a third of all days. Only used to dim the " +
               "circle when the colour mode asks for it.")
cfT1     = input.float(0.10, "Tier 2 starts at", step = 0.01, minval = 0.0, maxval = 0.5,
     inline = "cft", group = "Confidence")
cfT2     = input.float(0.20, "tier 3", step = 0.01, minval = 0.0, maxval = 0.5,
     inline = "cft", group = "Confidence")
cfT3     = input.float(0.30, "tier 4", step = 0.01, minval = 0.0, maxval = 0.5,
     inline = "cft", group = "Confidence")
cfC1     = input.color(#ef5350, "Tier 1", inline = "cfc", group = "Confidence")
cfC2     = input.color(#ffa726, "2", inline = "cfc", group = "Confidence")
cfC3     = input.color(#9ccc65, "3", inline = "cfc", group = "Confidence")
cfC4     = input.color(#00e676, "4", inline = "cfc", group = "Confidence")

cfQ1     = input.float(0.111, "Range-ratio quartiles", step = 0.005, minval = 0.001,
     inline = "cfq", group = "Confidence")
cfQ2     = input.float(0.154, "", step = 0.005, minval = 0.001, inline = "cfq", group = "Confidence")
cfQ3     = input.float(0.215, "", step = 0.005, minval = 0.001, inline = "cfq", group = "Confidence")

showPanel = input.bool(true, "Show panel", group = "Panel")
panelPos  = input.string("Top right", "Position", group = "Panel",
     options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"])
panelSize = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = "Panel")

//=============================================================================
// EFFECTIVE SETTINGS
//
// v1.0 is the frozen original: the 2.0 edge as the zone, a market entry at the
// read hour, stop and target both 1.5 R from that entry, and no filters at all.
// Selecting it overrides the inputs below rather than hiding them, so you can
// see exactly what changes.
//=============================================================================

float trTgtMul = str.contains(trTgt, "2.5") ? 2.5 : 2.0
float trEntF   = str.contains(trEntry, "0.62") ? 0.62 :
     str.contains(trEntry, "0.70") ? 0.70 : 0.79
bool  trEntVW  = str.contains(trEntry, "VWAP")
bool  trEntBox = str.contains(trEntry, "Origin box")
float trStopFb = str.contains(trStop, "0.88") ? 0.88 :
     str.contains(trStop, "0.95") ? 0.95 : 1.0
bool  trStopVW = str.contains(trStop, "VWAP")
bool  trStopBx = str.contains(trStop, "Origin box")

float e_lvl1   = lvl1
float e_pull   = tgtPull
bool  e_BE     = useBE
bool  e_lock   = lockOne
bool  e_cutOpp = cutOpp
bool  e_rngF   = useRngF

//=============================================================================
// CALENDAR + SOURCE CANDLE
//=============================================================================

f_midnight(int t) =>
    timestamp(TZ, year(t, TZ), month(t, TZ), dayofmonth(t, TZ), 0, 0, 0)

f_nextMidnight(int t) =>
    f_midnight(f_midnight(t) + 26 * 3600000)

f_src() =>
    var float sH = na
    var float sL = na
    var int   sD = na
    if hour(time[1], TZ) == srcHour
        sH := high[1]
        sL := low[1]
        sD := f_nextMidnight(time[1])
    [sH, sL, sD]

[srcHigh, srcLow, srcDay] = request.security(syminfo.tickerid, "60", f_src(),
     lookahead = barmerge.lookahead_off)

//=============================================================================
// STATE
//=============================================================================
// Lane state resets every night. Trade state does not - the position outlives
// the session that opened it, which is the whole point of this version.

var float  R        = na
var float  upEdge   = na
var float  dnEdge   = na
var float  boxHi    = na
var float  boxLo    = na
var int    laneDay  = na
var bool   called   = false
var bool   waiting  = false
var bool   dead     = false
var bool   preHit   = false
var int    side     = 0
var string why      = ""

var bool   tOpen    = false      // a position is live
var int    tSide    = 0
var int    tLane    = na         // the lane it was opened in
var float  tEntry   = na
var float  tStop    = na
var float  tTgt     = na
var float  tRR      = na
var float  tRisk    = na
var float  tBE      = na         // the break-even arming level, when enabled
var bool   tBeDone  = false
var string tHow     = ""         // what filled it
var string lastOut  = ""
var int    lastKind = 0          // 1 win, 2 loss, 3 flat
var float  z20u     = na         // the true 2.0 edges
var float  z20d     = na
// the running record, counted from the account start date
var int    stW      = 0
var int    stL      = 0
var float  stRw     = 0.0
var float  stRl     = 0.0
var int    stCallW  = 0
var int    stCallN  = 0
var float  pz20u    = na         // and yesterday's pair
var float  pz20d    = na
var float  lastR    = na         // the R won or lost
var float  sumR     = 0.0
var int    nWin     = 0
var int    nLos     = 0

var line   lnE      = na
var line   lnS      = na
var line   lnT      = na
var line   lnB      = na
var label  tagS     = na
var label  tagT     = na

bool intraday = not timeframe.isdwm
bool newSrc = intraday and not na(srcDay) and not na(srcHigh) and (na(laneDay) or srcDay != laneDay)

bool laneOpen = intraday and not na(laneDay) and time >= laneDay and time[1] < laneDay
// "Session" is the built-in VWAP's own anchor, so the two lines coincide.
float vwSess = ta.vwap(vwSrc)
float vwLane = ta.vwap(vwSrc, laneOpen)
float vw = vwAnc == "Session" ? vwSess : vwLane

if newSrc and (srcHigh - srcLow) > 0
    laneDay := srcDay
    boxHi   := srcHigh
    boxLo   := srcLow
    R       := srcHigh - srcLow
    // The order rests just inside the edge, so the drawn level and the level
    // actually worked are not the same thing.
    float tgtLvl = math.max(e_lvl1 - e_pull, 0.1)
    upEdge  := srcHigh + tgtLvl * R
    dnEdge  := srcLow  - tgtLvl * R
    // The true 2.0 edges. The fibs and the confidence score are both built from
    // these, not from the pulled-in target level. This block runs at 22:00, an
    // hour before the lane opens, so yesterday's pair is banked here - by the
    // time laneOpen runs the new values are already in place.
    pz20u   := z20u
    pz20d   := z20d
    z20u    := srcHigh + 2.0 * R
    z20d    := srcLow  - 2.0 * R
    called  := false
    waiting := false
    dead    := false
    preHit  := false
    side    := 0
    why     := (e_rngF and R >= maxRng)
         ? "range $" + str.tostring(R, "#.##") + " over the $"
           + str.tostring(maxRng, "#") + " limit - no trade"
         : "waiting for " + str.format("{0,number,00}:00", readHour) + " NY"
    if e_rngF and R >= maxRng
        dead := true

bool inLane = intraday and not na(laneDay) and time >= laneDay and time < laneDay + 86400000

//=============================================================================
// CONFIDENCE ENGINE
//
// Deliberately separate from the trade engine and gated by nothing it does.
// An open position from yesterday, an oversized range, a zone already taken -
// none of them suppress the reading. It fires at the read hour every day.
//=============================================================================

var float cfRaw   = na          // |pos - 0.5| between the true 2.0 edges
var int   cfSide  = 0
var float cfHit   = na          // measured historical hit rate, %
var float cfRatio = na          // today's R / yesterday's full lane range
var int   cfQ     = 0           // which quartile that ratio falls in
var int   cfTier  = 0
var bool  cfDone  = false
var float laneHi  = na
var float laneLo  = na
var float prevRng = na
var float prevHi  = na          // yesterday's lane extremes, frozen at the open
var float prevLo  = na
var float pvHi    = na          // running last confirmed swing, either side
var float pvLo    = na
var float dayPvHi = na          // the previous lane's swings, frozen at the open
var float dayPvLo = na
var float asHi    = na          // Asia, accumulating
var float asLo    = na
var float asiaHi  = na          // Asia, frozen for this lane
var float asiaLo  = na

// Asia builds in the hours before the lane opens. It is accumulated while the
// window is open and frozen on the bar the window closes, which handles both
// the windows that end at midnight and the ones that run past it.
int asH = hour(time, TZ)
bool inAsia = fzAsiaW == "18:00 - 00:00" ? (asH >= 18) :
     fzAsiaW == "20:00 - 02:00"          ? (asH >= 20 or asH < 2) :
     fzAsiaW == "19:00 - 02:00"          ? (asH >= 19 or asH < 2) : (asH >= 19)
if intraday
    if inAsia and not inAsia[1]
        asHi := high
        asLo := low
    else if inAsia
        asHi := math.max(nz(asHi, high), high)
        asLo := math.min(nz(asLo, low), low)
    else if inAsia[1]
        asiaHi := asHi
        asiaLo := asLo

// Swing pivots. ta.pivothigh confirms fzPiv bars after the fact, so the value
// is only ever read once it is settled - no repainting.
float _ph = ta.pivothigh(high, fzPiv, fzPiv)
float _pl = ta.pivotlow(low,  fzPiv, fzPiv)
if not na(_ph)
    pvHi := _ph
if not na(_pl)
    pvLo := _pl

if laneOpen
    prevRng := na(laneHi) or na(laneLo) ? na : laneHi - laneLo
    prevHi  := laneHi
    prevLo  := laneLo
    // Whatever the last confirmed swing was as the day turned over is, by
    // definition, yesterday's most recent swing point.
    dayPvHi := fzSwSrc == "Deepest swing of the previous day" ? laneHi : pvHi
    dayPvLo := fzSwSrc == "Deepest swing of the previous day" ? laneLo : pvLo
    laneHi  := high
    laneLo  := low
    cfDone  := false
    cfRaw   := na
    cfHit   := na
    cfRatio := na
    cfSide  := 0
    cfQ     := 0
    cfTier  := 0
else if inLane
    laneHi := na(laneHi) ? high : math.max(laneHi, high)
    laneLo := na(laneLo) ? low  : math.min(laneLo, low)

if inLane and not cfDone and not na(R) and R > 0 and hour(time, TZ) >= readHour
    cfDone := true
    float pz = (open - z20d) / (z20u - z20d)
    cfRaw  := math.abs(pz - 0.5)
    cfSide := pz > 0.5 ? 1 : -1
    cfRatio := na(prevRng) or prevRng <= 0 ? na : R / prevRng
    cfQ := na(cfRatio) ? 0 :
         cfRatio < cfQ1 ? 1 : cfRatio < cfQ2 ? 2 : cfRatio < cfQ3 ? 3 : 4
    cfHit  := f_cfHit(cfRaw, cfQ, cfGrid)
    cfTier := cfRaw < cfT1 ? 1 : cfRaw < cfT2 ? 2 : cfRaw < cfT3 ? 3 : 4

bool cfJust = inLane and cfDone and not cfDone[1]

// The call's own record, settled the moment either 2.0 edge trades.
var int  clSide = 0
var bool clOpen = false
if cfJust and cfSide != 0 and time >= acFrom
    clSide := cfSide
    clOpen := true
if clOpen and not na(z20u)
    bool hu = high >= z20u
    bool hd = low  <= z20d
    if hu or hd
        stCallN += 1
        stCallW += ((hu and clSide > 0) or (hd and clSide < 0)) ? 1 : 0
        clOpen  := false

//=============================================================================
// MANAGE THE OPEN POSITION - before anything else, so a call cannot fire on a
// bar that also closes the trade
//=============================================================================

bool justWon  = false
bool justLost = false
bool justBE   = false
bool justOut  = false

if intraday and tOpen
    // The stop is tested first, against the stop as it stands. Only then can
    // this bar arm break-even - so a bar that reaches both is a loss, not a
    // save, which is the honest reading when you cannot see inside the bar.
    bool hitStop = (tSide > 0 and low <= tStop) or (tSide < 0 and high >= tStop)
    if hitStop
        tOpen   := false
        lastR   := tBeDone ? 0.0 : -1.0
        lastOut := tBeDone ? "closed at break-even, 0.00R" : "stopped out, -1.00R"
        justBE   := tBeDone
        justLost := not tBeDone
    else
        if e_BE and not tBeDone and not na(tBE)
            if (tSide > 0 and high >= tBE) or (tSide < 0 and low <= tBE)
                tBeDone := true
                tStop   := tEntry
        bool hitTgt = (tSide > 0 and high >= tTgt) or (tSide < 0 and low <= tTgt)
        if hitTgt
            tOpen   := false
            lastR   := tRR
            lastOut := "target hit, +" + str.tostring(tRR, "#.##") + "R"
            justWon := true
        else if not na(tLane) and time > tLane + maxDays * 86400000
            tOpen   := false
            lastR   := na(tRisk) or tRisk <= 0 ? 0.0 : tSide * (close - tEntry) / tRisk
            lastOut := "unresolved after " + str.tostring(maxDays) + " days - closed at "
                 + (lastR >= 0 ? "+" : "") + str.tostring(lastR, "0.00") + "R"
            justWon  := lastR > 0
            justLost := lastR < 0
            justBE   := lastR == 0

    justOut := justWon or justLost or justBE
    if justOut
        lastKind := justWon ? 1 : justLost ? 2 : 3
        sumR     := sumR + lastR
        nWin     := nWin + (lastR > 0 ? 1 : 0)
        nLos     := nLos + (lastR < 0 ? 1 : 0)

//=============================================================================
// PRE-CALL: has the 2.0 zone already gone?
//=============================================================================

if inLane and not called and not dead
    if high >= upEdge or low <= dnEdge
        preHit := true

//=============================================================================
// THE CALL
//=============================================================================

bool skipped = false

if inLane and not dead and not called and hour(time, TZ) >= readHour
    called := true
    float px  = open
    float gUp = (upEdge - px) / R
    float gDn = (px - dnEdge) / R
    side := gUp < gDn ? 1 : -1
    bool gone = side > 0 ? px >= upEdge : px <= dnEdge

    // A call that opposes an open position is an exit signal for it - but only
    // while it is under water. A winner is left alone to reach its target.
    if e_cutOpp and tOpen and tSide != side and not na(tRisk) and tRisk > 0
        float prog = tSide * (px - tEntry) / tRisk
        if prog <= cutBelow
            tOpen   := false
            lastR   := prog
            lastOut := "closed by an opposing call, "
                 + (prog >= 0 ? "+" : "") + str.tostring(prog, "0.00") + "R"
            justWon  := prog > 0
            justLost := prog < 0
            justBE   := prog == 0
            justOut  := true
            lastKind := justWon ? 1 : justLost ? 2 : 3
            sumR     := sumR + prog
            nWin     := nWin + (prog > 0 ? 1 : 0)
            nLos     := nLos + (prog < 0 ? 1 : 0)

    if e_lock and tOpen
        dead    := true
        skipped := true
        why     := "still in a " + (tSide > 0 ? "long" : "short") + " - call skipped"
    else if preHit or gone
        dead := true
        why  := "the zone had already gone before the call - no trade"
    else
        waiting := true
        why     := "called - waiting for a VWAP tap before "
             + str.format("{0,number,00}:00", cutHour)

//=============================================================================
// WAITING FOR THE TAP
//=============================================================================

bool justFilled = false

if inLane and waiting and not dead
    float proj = side > 0 ? upEdge : dnEdge
    float stopWould = side > 0 ? boxLo - bufD : boxHi + bufD
    if (side > 0 and low <= stopWould) or (side < 0 and high >= stopWould)
        waiting := false
        dead    := true
        why     := "stop level reached before the entry - cancelled"
    else if (side > 0 and high >= proj) or (side < 0 and low <= proj)
        waiting := false
        dead    := true
        why     := "the zone was reached before the entry - cancelled"
    else if hour(time, TZ) >= cutHour
        waiting := false
        dead    := true
        why     := "no entry trigger before the cutoff - no trade"
    else
        // The one trigger. A tap of the VWAP, intrabar, not on the close.
        float ent = na
        string how = ""
        if not na(vw) and low <= vw and vw <= high
            ent := vw
            how := "VWAP"

        if not na(ent)
            // The box level always decides whether the setup is still alive
            // above; only the live stop changes with the mode.
            float useStop = stopMode == "Beyond the VWAP" and not na(vw)
                 ? vw - side * stopPips * pipSize : stopWould
            bool  badStop = (side > 0 and useStop >= ent) or (side < 0 and useStop <= ent)
            float risk = badStop ? 0.0 : math.abs(ent - useStop)
            if risk > 0
                waiting := false
                tOpen   := true
                tSide   := side
                tLane   := laneDay
                tEntry  := ent
                tStop   := useStop
                tRisk   := risk
                tHow    := how
                tTgt    := proj
                tBE     := ent + side * (beFrac / 100.0) * math.abs(proj - ent)
                tBeDone := false
                tRR     := math.abs(proj - ent) / risk
                justFilled := true
                why := "filled on " + how + " - target is the "
                     + str.tostring(lvl1, "#.##") + " edge at "
                     + str.tostring(tRR, "#.##") + ":1, stop "
                     + (stopMode == "Beyond the VWAP" ? "beyond the VWAP" : "behind the box")

bool justCalled = inLane and called and not called[1]

//=============================================================================
// DRAWING
//=============================================================================

f_mark(int dir, string shape, string emoUp, string emoDn, string txt, color col,
       string sz, float off, color txtCol, int transp) =>
    string body = shape == "Emoji" ? (dir > 0 ? emoUp : emoDn) + (txt == "" ? "" : " " + txt) : txt
    float yv = dir > 0 ? low - off * R : high + off * R
    label.new(bar_index, yv, body, style = f_shape(shape, dir),
         color = shape == "Emoji" or shape == "Text only" ? color.new(col, 100) : color.new(col, transp),
         textcolor = shape == "Emoji" ? color.new(color.white, 0) : txtCol,
         size = f_size(sz), yloc = yloc.price)

if justCalled and side != 0
    if skipped and dSkip
        f_mark(side, dShape, dUpEmo, dDnEmo, "", dSkipCol, dSize, dOff, color.white, 60)
    else if dShow and not dead
        f_mark(side, dShape, dUpEmo, dDnEmo, "", side > 0 ? dUpCol : dDnCol,
             dSize, dOff, color.white, dTrans)
    // The score rides alongside the marker rather than sitting in a corner, so
    // the day's reading is where the day's call is.
    if dConf and not na(cfHit)
        label.new(bar_index, side > 0 ? low - (dOff + 0.28) * R : high + (dOff + 0.28) * R,
             str.tostring(cfHit, "#") + "%", style = label.style_none,
             color = color.new(color.black, 100), textcolor = dConfC,
             size = f_size(dSize), yloc = yloc.price)

if justFilled and eShow
    string et = eText == "None" ? "" :
         eText == "Price" ? str.tostring(tEntry, format.mintick) :
         eText == "RR" ? str.tostring(tRR, "#.##") + "R" :
         str.tostring(tEntry, format.mintick) + "  " + str.tostring(tRR, "#.##") + "R"
    f_mark(tSide, eShape, eUpEmo, eDnEmo, et, tSide > 0 ? eUpCol : eDnCol,
         eSize, eOff, eTxtCol, eTrans)

f_exit(int kind, float rres) =>
    color  c   = kind == 1 ? xWinCol : kind == 2 ? xLosCol : xBeCol
    string emo = kind == 1 ? xWinEmo : kind == 2 ? xLosEmo : xBeEmo
    string rt  = (rres > 0 ? "+" : "") + str.tostring(rres, "0.00") + "R"
    string wd  = kind == 1 ? "TARGET" : kind == 2 ? "STOP" : "FLAT"
    string txt = xText == "None" ? "" : xText == "R result" ? rt :
         xText == "Words" ? wd : wd + "  " + rt
    string body = xShape == "Emoji" ? emo + (txt == "" ? "" : " " + txt) : txt
    bool above = xPlace == "Always above" or
         (xPlace == "Win above, loss below" and kind != 2)
    float pad = na(R) ? syminfo.mintick * 100 : xOff * R
    // "Clear of the zones" parks the marker outside the projection box, where no
    // candle can reach it. "Above the zones" always puts it over the top edge.
    float yv = na
    if xPlace == "Above the zones" and not na(upEdge)
        yv := upEdge + pad
    else if xPlace == "Clear of the zones" and not na(upEdge) and not na(dnEdge)
        yv := tSide < 0 or (tSide == 0 and side < 0) ? dnEdge - pad : upEdge + pad
    else
        yv := above ? high + pad : low - pad
    bool flat = xShape == "Emoji" or xShape == "Text only"
    label.new(bar_index, yv, body, style = f_shape(xShape, kind == 2 ? -1 : 1),
         color = flat ? color.new(c, 100) : color.new(c, xTrans),
         textcolor = flat ? c : xTxtCol, size = f_size(xSize), yloc = yloc.price)

if xShow and justOut
    f_exit(lastKind, lastR)

f_tag(float y, string txt, color c) =>
    label.new(bar_index, y, txt, style = label.style_label_left,
         color = color.new(c, 85), textcolor = c, size = f_size(tagSize),
         yloc = yloc.price)

if justFilled
    if shEntry
        lnE := line.new(bar_index, tEntry, bar_index + 1, tEntry, color = cEntry,
             style = f_style(sEntry), width = wEntry)
    if shStop
        lnS := line.new(bar_index, tStop, bar_index + 1, tStop, color = cStop,
             style = f_style(sStop), width = wStop)
    if shTgt
        lnT := line.new(bar_index, tTgt, bar_index + 1, tTgt, color = cTgt,
             style = f_style(sTgt), width = wTgt)
    if useBE and shBE and not na(tBE)
        lnB := line.new(bar_index, tBE, bar_index + 1, tBE, color = cBE,
             style = f_style(sBE), width = 1)
    if priceTag
        tagS := f_tag(tStop, "SL " + str.tostring(tStop, format.mintick), cStop)
        tagT := f_tag(tTgt,  "TP " + str.tostring(tTgt, format.mintick)
             + "  " + str.tostring(tRR, "#.##") + "R", cTgt)

// The lines run for as long as the position does, and the stop follows break-even.
if tOpen
    if not na(lnE)
        line.set_x2(lnE, bar_index)
    if not na(lnS)
        line.set_x2(lnS, bar_index)
        line.set_y1(lnS, tStop)
        line.set_y2(lnS, tStop)
    if not na(lnT)
        line.set_x2(lnT, bar_index)
    if not na(lnB)
        line.set_x2(lnB, bar_index)
    if priceTag
        if not na(tagS)
            label.set_x(tagS, bar_index)
            label.set_y(tagS, tStop)
            label.set_text(tagS, (tBeDone ? "BE " : "SL ") + str.tostring(tStop, format.mintick))
        if not na(tagT)
            label.set_x(tagT, bar_index)

plot(shVwap and inLane and (waiting or tOpen) ? vw : na, "VWAP",
     color = cVwap, style = plot.style_linebr, linewidth = 1)

//=============================================================================
// PANEL
//=============================================================================

f_cell(table t, int c, int r, string s, color bg, color fg, string sz) =>
    table.cell(t, c, r, s, bgcolor = bg, text_color = fg, text_size = sz,
         text_halign = c == 0 ? text.align_left : text.align_right)

var table T = na

if barstate.islast and showPanel and intraday
    string pos = panelPos == "Top left" ? position.top_left :
         panelPos == "Bottom right" ? position.bottom_right :
         panelPos == "Bottom left" ? position.bottom_left :
         panelPos == "Middle right" ? position.middle_right : position.top_right
    if not na(T)
        table.delete(T)
    T := table.new(pos, 2, 7, border_width = 0, frame_width = 0,
         bgcolor = color.new(color.black, 100))
    string sz = f_size(panelSize)

    int   n    = stW + stL
    float totR = stRw - stRl
    float pnl  = acBal * acRisk / 100.0 * totR
    color fg   = color.new(#c8d4de, 12)
    color dim  = color.new(#c8d4de, 52)
    color bg   = color.new(color.black, 100)

    f_cell(T, 0, 0, "W / L", bg, dim, sz)
    f_cell(T, 1, 0, str.tostring(stW) + " / " + str.tostring(stL), bg, fg, sz)
    f_cell(T, 0, 1, "win rate", bg, dim, sz)
    f_cell(T, 1, 1, n == 0 ? "-" : str.tostring(100.0 * stW / n, "#.#") + "%", bg, fg, sz)
    f_cell(T, 0, 2, "total R", bg, dim, sz)
    f_cell(T, 1, 2, (totR >= 0 ? "+" : "") + str.tostring(totR, "#.#"), bg,
         totR >= 0 ? acWinC : acLosC, sz)
    f_cell(T, 0, 3, "P&L", bg, dim, sz)
    f_cell(T, 1, 3, (pnl >= 0 ? "+$" : "-$") + str.tostring(math.abs(pnl), "#.##"), bg,
         pnl >= 0 ? acWinC : acLosC, sz)
    f_cell(T, 0, 4, "avg R", bg, dim, sz)
    f_cell(T, 1, 4, n == 0 ? "-" : (totR / n >= 0 ? "+" : "")
         + str.tostring(totR / n, "0.00"), bg, fg, sz)
    f_cell(T, 0, 5, "avg win", bg, dim, sz)
    f_cell(T, 1, 5, stW == 0 ? "-" : "+" + str.tostring(stRw / stW, "0.00") + "R",
         bg, fg, sz)
    f_cell(T, 0, 6, "call", bg, dim, sz)
    f_cell(T, 1, 6, stCallN == 0 ? "-" : str.tostring(100.0 * stCallW / stCallN, "#.#")
         + "%  " + str.tostring(stCallN), bg, fg, sz)

//=============================================================================
// FIB ZONES
//
// One object per zone while it sleeps, so a chart holds plenty of history. The
// levels and the stop are only created when a zone actually goes live.
//=============================================================================

type Zone
    float   A                   // the 1 anchor
    float   T                   // the -0.27 target, a 2.0 projection edge
    int     side                // +1 long, -1 short
    int     st                  // 0 dormant 1 live 2 armed 3 won 4 spent
    box     bx
    line    l1
    line    l2
    line    l3
    line    ls                  // the stop
    line    lt                  // the target
    label   tag
    label   res
    int     lane
    bool    dead

var array<Zone> ZS = array.new<Zone>()

f_lv(float a_, float t_, float f) => a_ + (1.0 - f) / 1.27 * (t_ - a_)

// Dark charts want a lighter fill than the background, light charts a darker
// one. The transparency the user set is preserved either way.
f_theme(color c) =>
    fzTheme == "Dark" ? c :
     color.new(fzTheme == "Light grey" ? #4a5a66 : #2b3740, color.t(c))

f_zEnd(int laneT) => laneT + fzEndH * 3600000

// Build one zone, dormant, as a single box.
f_zNew(float A_, float T_, int sd, int x1, int x2) =>
    Zone z = Zone.new(A_, T_, sd, 0, na, na, na, na, na, na, na, na, laneDay, false)
    float e = f_lv(A_, T_, trEntF)
    float d = f_lv(A_, T_, 0.79)
    float u = f_lv(A_, T_, 0.62)
    z.bx := box.new(x1, math.max(u, d), x2, math.min(u, d),
         border_color = color.new(color.black, 100),
         bgcolor = f_theme(fzDorm), xloc = xloc.bar_index)
    array.push(ZS, z)
    z

f_zLevels(Zone z, int x1, int x2) =>
    color c = f_theme(fzLine)
    z.l1 := line.new(x1, f_lv(z.A, z.T, 0.62), x2, f_lv(z.A, z.T, 0.62),
         xloc = xloc.bar_index, color = c, style = line.style_dotted)
    z.l2 := line.new(x1, f_lv(z.A, z.T, 0.70), x2, f_lv(z.A, z.T, 0.70),
         xloc = xloc.bar_index, color = c, style = line.style_dotted)
    z.l3 := line.new(x1, f_lv(z.A, z.T, 0.79), x2, f_lv(z.A, z.T, 0.79),
         xloc = xloc.bar_index, color = c, style = line.style_dotted)
    if fzShowN
        z.tag := label.new(x1, f_lv(z.A, z.T, 0.70), "0.62\n0.70\n0.79",
             style = label.style_label_right, color = color.new(color.black, 100),
             textcolor = c, size = f_size(fzTxt), xloc = xloc.bar_index)

f_zRecolour(Zone z) =>
    if z.st == 0 or z.st == 4
        box.set_bgcolor(z.bx, f_theme(fzDorm))
        box.set_border_color(z.bx, f_theme(fzDormB))
    else if z.st == 1
        box.set_bgcolor(z.bx, f_theme(fzLive))
        box.set_border_color(z.bx, f_theme(fzEdge))
    else
        // A won zone is a hue, not a highlight. The levels stay grey so the green
        // reads as a tint over the chart rather than a block of colour.
        box.set_bgcolor(z.bx, f_theme(fzWonF))
        box.set_border_color(z.bx, f_theme(fzWin))
        if not na(z.l1)
            line.set_color(z.l1, f_theme(fzWonL))
            line.set_color(z.l2, f_theme(fzWonL))
            line.set_color(z.l3, f_theme(fzWonL))
        if not na(z.tag)
            label.set_textcolor(z.tag, f_theme(fzWonL))

// Everything the zone drew, gone.
f_zStrip(Zone z) =>
    if not na(z.l1)
        line.delete(z.l1)
        line.delete(z.l2)
        line.delete(z.l3)
        z.l1 := na
    if not na(z.tag)
        label.delete(z.tag)
        z.tag := na
    if not na(z.ls)
        line.delete(z.ls)
        z.ls := na
    if not na(z.lt)
        line.delete(z.lt)
        z.lt := na

// The per-bar driver. The day's zones are built once at the lane open, then each
// is walked through its states. Every transition is decided on a closed bar.
var int fzX1 = na
var int fzX2 = na

f_zSpawn(float A_, int sd) =>
    if not na(A_) and not na(R) and R > 0
        float T_ = sd > 0 ? (boxHi + trTgtMul * R) : (boxLo - trTgtMul * R)
        float z_ = sd > 0 ? z20u : z20d          // the fib is always built to 2.0
        if (sd > 0 and z_ - A_ > 0) or (sd < 0 and z_ - A_ < 0)
            f_zNew(A_, T_, sd, bar_index, bar_index + 1)

if fzOn and intraday and laneOpen and not na(z20u)
    fzX1 := bar_index
    int only = side != 0 ? side : 1
    for k = 0 to (fzBoth ? 1 : 0)
        int sd = fzBoth ? (k == 0 ? 1 : -1) : only
        if fzA1
            f_zSpawn(sd > 0 ? z20d : z20u, sd)
        if fzA2
            f_zSpawn(sd > 0 ? asiaLo : asiaHi, sd)
        if fzA3
            f_zSpawn(sd > 0 ? dayPvLo : dayPvHi, sd)
        if fzA4
            f_zSpawn(sd > 0 ? pz20d : pz20u, sd)

// the end-to-end box: the day's two extremes, so the outer frame is always there
var box  eeBx = na
var line eeUp = na
var line eeDn = na
if eeShow and intraday and laneOpen and not na(z20u)
    eeBx := box.new(bar_index, z20u, bar_index + 1, z20d, border_color = eeBord,
         border_width = eeW, bgcolor = eeFill, xloc = xloc.bar_index)
    eeUp := line.new(bar_index, z20u, bar_index + 1, z20u, xloc = xloc.bar_index,
         color = eeEdge, width = eeEdgeW)
    eeDn := line.new(bar_index, z20d, bar_index + 1, z20d, xloc = xloc.bar_index,
         color = eeEdge, width = eeEdgeW)

// everything drawn for the day shares one right edge, so the blocks line up
bool inBlock = inLane and hour(time, TZ) < fzEndH
if intraday and inBlock
    fzX2 := bar_index + 1
    if not na(eeBx)
        box.set_right(eeBx, fzX2)
        line.set_x2(eeUp, fzX2)
        line.set_x2(eeDn, fzX2)

if fzOn and intraday and array.size(ZS) > 0
    for i = 0 to array.size(ZS) - 1
        Zone z = array.get(ZS, i)
        if z.dead or z.lane != laneDay
            continue
        int x2 = na(fzX2) ? bar_index + 1 : fzX2
        box.set_right(z.bx, x2)
        if not na(z.l1)
            line.set_x2(z.l1, x2)
            line.set_x2(z.l2, x2)
            line.set_x2(z.l3, x2)
        if not na(z.ls)
            line.set_x2(z.ls, x2)
        if not na(z.lt)
            line.set_x2(z.lt, x2)
        float hi  = math.max(f_lv(z.A, z.T, 0.62), f_lv(z.A, z.T, 0.79))
        float lo  = math.min(f_lv(z.A, z.T, 0.62), f_lv(z.A, z.T, 0.79))
        float ent = f_lv(z.A, z.T, trEntF)
        float stp = trStopBx ? (z.side > 0 ? boxLo - trPad : boxHi + trPad) :
             trStopVW and not na(vw) ? vw - z.side * trPad :
             f_lv(z.A, z.T, trStopFb)
        bool inBox = low <= hi and high >= lo
        if z.st == 0 and inBox
            z.st := 1
            f_zLevels(z, fzX1, x2)
            f_zRecolour(z)
        else if z.st == 1
            bool through = z.side > 0 ? close < lo : close > hi
            bool backOut = z.side > 0 ? low > hi : high < lo
            if through
                z.st := 4
                f_zStrip(z)
                f_zRecolour(z)
            else if backOut
                z.st := 2
                f_zRecolour(z)
                z.ls := line.new(fzX1, stp, x2, stp, xloc = xloc.bar_index,
                     color = fzStpC, width = fzLnW)
                z.lt := line.new(fzX1, z.T, x2, z.T, xloc = xloc.bar_index,
                     color = fzTgtC, width = fzLnW)
        else if z.st == 2
            bool hitT  = z.side > 0 ? high >= z.T : low <= z.T
            bool hitS  = z.side > 0 ? low <= stp : high >= stp
            bool count = time >= acFrom
            float risk = math.abs(ent - stp)
            float rr   = risk > 0 ? math.abs(z.T - ent) / risk : 0.0
            if hitS
                stL  += count ? 1 : 0
                stRl += count ? 1.0 : 0.0
                // The zone sinks back, but the result still prints. It is deleted
                // again if a zone on the same lane later wins, so the day ends
                // showing only the trade worth having taken.
                z.st := 4
                z.dead := true
                f_zStrip(z)
                f_zRecolour(z)
                if acShow
                    z.res := label.new(fzX1, stp, "-1.00R   -$"
                         + str.tostring(acBal * acRisk / 100.0, "#.##"),
                         style = z.side > 0 ? label.style_label_upper_right
                                            : label.style_label_lower_right,
                         color = color.new(color.black, 100), textcolor = acLosC,
                         size = f_size(acSize), xloc = xloc.bar_index)
            else if hitT
                stW  += count ? 1 : 0
                stRw += count ? rr : 0.0
                z.st := 3
                z.dead := true
                f_zRecolour(z)
                // exactly one green zone a day - every other zone on this lane
                // mutes, and its result label goes with it
                for jj = 0 to array.size(ZS) - 1
                    Zone o = array.get(ZS, jj)
                    if o.lane == z.lane and jj != i and o.st != 3
                        o.st := 4
                        o.dead := true
                        f_zStrip(o)
                        f_zRecolour(o)
                        if not na(o.res)
                            label.delete(o.res)
                            o.res := na
                if acShow
                    z.res := label.new(fzX1, z.T, "+" + str.tostring(rr, "#.##")
                         + "R   +$" + str.tostring(acBal * acRisk / 100.0 * rr, "#.##"),
                         style = z.side > 0 ? label.style_label_lower_right
                                            : label.style_label_upper_right,
                         color = color.new(color.black, 100), textcolor = acWinC,
                         size = f_size(acSize), xloc = xloc.bar_index)

//=============================================================================
// CONFIDENCE DASHBOARD
//
// Two transparent cells, no frame, no border, no background. Just the circle
// and the number.
//=============================================================================

var table CF = na

if barstate.islast and cfShow and intraday
    if not na(CF)
        table.delete(CF)
    CF := table.new(f_cfPos(cfPos), 2, 1, border_width = 0, frame_width = 0,
         bgcolor = color.new(color.black, 100),
         frame_color = color.new(color.black, 100),
         border_color = color.new(color.black, 100))

    color tierCol = cfTier == 1 ? cfC1 : cfTier == 2 ? cfC2 : cfTier == 3 ? cfC3 :
         cfTier == 4 ? cfC4 : cfNaCol
    color dirCol  = cfSide > 0 ? cfUpCol : cfSide < 0 ? cfDnCol : cfNaCol
    color dotCol  = cfDotBy == "Confidence tier" ? tierCol :
         cfDotBy == "Direction, dimmed when weak" and not na(cfRaw) and cfRaw < cfFloor
         ? color.new(dirCol, 55) : dirCol

    string score = na(cfRaw) ? "-" :
         cfMode == "Lopsidedness" ? str.tostring(cfRaw, "0.000") :
         cfMode == "Both" ? str.tostring(cfHit, "#.#") + "%  " + str.tostring(cfRaw, "0.000") :
         str.tostring(cfHit, "#.#") + "%"

    table.cell(CF, 0, 0, cfDot, bgcolor = color.new(color.black, 100),
         text_color = color.new(dotCol, cfDotTr), text_size = f_size(cfDotSz),
         text_halign = text.align_right, text_valign = text.align_center)
    table.cell(CF, 1, 0, score, bgcolor = color.new(color.black, 100),
         text_color = color.new(cfNumCol, cfNumTr), text_size = f_size(cfNumSz),
         text_halign = text.align_left, text_valign = text.align_center)

//=============================================================================
// ALERTS
//=============================================================================

alertcondition(justCalled and side ==  1 and not skipped, "Direction: UP",   "Direction call: UP")
alertcondition(justCalled and side == -1 and not skipped, "Direction: DOWN", "Direction call: DOWN")
alertcondition(justCalled and skipped, "Call skipped", "Call skipped - already in a position")
alertcondition(justFilled, "Entry filled", "Entry trigger hit - stop and target set")
alertcondition(e_BE and tBeDone and not tBeDone[1], "Break-even",
     "Part-way to target - stop moved to break-even")
alertcondition(justWon,  "Trade won",  "Target hit at the far zone edge")
alertcondition(justLost, "Trade lost", "Stopped out, -1R")
alertcondition(justBE,   "Trade flat", "Closed flat, 0R")

alertcondition(cfJust, "Confidence: reading ready", "Confidence score set for the day")
alertcondition(cfJust and cfTier >= 3, "Confidence: strong or better",
     "A strong call - lopsidedness is in the top two tiers")
alertcondition(cfJust and cfTier == 4, "Confidence: prime",
     "A prime call - lopsidedness is in the top tier")
alertcondition(cfJust and cfTier <= 1, "Confidence: weak",
     "A weak call - close to a coin flip, consider sitting out")
